# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 다음,
# 아래 YOUR_... 자리에 실제 값을 채워 넣으세요.
# .env 파일은 절대 깃허브 등에 올리지 마세요 (아래 .gitignore가 이미 막아줍니다).

# 모두싸인 API 인증 정보
# (API 키는 MODUSIGN_API_KEY 를 권장하며, 기존 API_KEY 도 계속 인식됩니다)
MODUSIGN_EMAIL=YOUR_EMAIL
MODUSIGN_API_KEY=YOUR_API_KEY

# 관리자 페이지 로그인 정보
ADMIN_USER=YOUR_ADMIN_USER
ADMIN_PASS=YOUR_ADMIN_PASS

# 업로드 링크 서명용 비밀키 (아무 긴 임의 문자열이면 됩니다)
LINK_SECRET=YOUR_LINK_SECRET

# ── NHN 발신번호 자동화 ──────────────────────────────
# 실제 심사 제출까지 진행하려면 1 (기본은 드라이런: 제출 직전까지만)
# NHN_SUBMIT=1
# 봇 창을 숨기고 실행하려면 1 (제출 봇)
# NHN_HEADLESS=1
# NHN 심사 결과 자동 주기 조회 끄기: 0 (기본 켜짐, 세션이 있을 때만 동작)
# NHN_SYNC=0
# 자동 조회 주기(분). 기본 30분, 최소 10분
# NHN_SYNC_INTERVAL_MIN=30
