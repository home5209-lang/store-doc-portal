# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 다음,
# 아래 YOUR_... 자리에 실제 값을 채워 넣으세요.
# .env 파일은 절대 깃허브 등에 올리지 마세요 (아래 .gitignore가 이미 막아줍니다).

# 모두싸인 API 인증 정보
# (API 키는 MODUSIGN_API_KEY 를 권장하며, 기존 API_KEY 도 계속 인식됩니다)
MODUSIGN_EMAIL=YOUR_EMAIL
MODUSIGN_API_KEY=YOUR_API_KEY

# 관리자 로그인 — 구글(회사 SSO). Google Cloud Console에서 OAuth 2.0 클라이언트(웹) 생성 후:
#   승인된 리디렉션 URI: http://localhost:3000/auth/google/callback  (배포 시 실제 도메인/callback)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# 콜백 URL 구성용(로컬 기본값). 배포 시 https 도메인으로 변경
BASE_URL=http://localhost:3000
# 허용 이메일 도메인(이 도메인 계정만 로그인 가능)
ALLOWED_EMAIL_DOMAIN=catchtable.co.kr
# 세션 쿠키 서명용 비밀키(없으면 LINK_SECRET 사용). 긴 임의 문자열 권장
SESSION_SECRET=YOUR_SESSION_SECRET

# (구버전 공용 Basic 로그인 — 더 이상 사용하지 않음)
# ADMIN_USER=YOUR_ADMIN_USER
# ADMIN_PASS=YOUR_ADMIN_PASS

# 업로드 링크 서명용 비밀키 (아무 긴 임의 문자열이면 됩니다)
LINK_SECRET=YOUR_LINK_SECRET

# 슬랙 알림 — 심사 완료/반려 시 채널로 알림. 슬랙 Incoming Webhook URL을 넣으세요.
# (미설정이면 알림만 생략되고 나머지는 정상 동작)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# NHN Cloud SMS API (발신번호 등록 상태 조회용 — 로그인 없이 API로 상태 확인)
# NHN 콘솔 → SMS → 우측 상단 "URL & Appkey" 에서 확인
NHN_SMS_APPKEY=YOUR_APPKEY
NHN_SMS_SECRETKEY=YOUR_SECRETKEY

# 캐치테이블 내부 어드민 API (매장 시퀀스넘버 → 매장명 자동 조회)
#   GET {CT_ADMIN_API_BASE}/internal-api/v1/shops/{시퀀스}
# 기본 주소가 코드에 내장돼 있어, 사내망에서 키 없이 호출되면 아래 3줄은 비워둬도 됩니다.
# 주소를 바꾸려면(또는 사내망 밖) CT_ADMIN_API_BASE 를 설정하세요.
# CT_ADMIN_API_BASE=https://ct-biz-manager-api.wadcorp.in
# 인증 키가 필요할 때만: 헤더 이름과 값. (예: Authorization / "Bearer xxxxx", 또는 X-API-Key / "xxxxx")
# CT_ADMIN_API_AUTH_HEADER=Authorization
# CT_ADMIN_API_KEY=YOUR_KEY

# ── NHN 발신번호 자동화 ──────────────────────────────
# 실제 심사 제출까지 진행하려면 1 (기본은 드라이런: 제출 직전까지만)
# NHN_SUBMIT=1
# 봇 창을 숨기고 실행하려면 1 (제출 봇)
# NHN_HEADLESS=1
# NHN 심사 결과 자동 주기 조회 끄기: 0 (기본 켜짐, 세션이 있을 때만 동작)
# NHN_SYNC=0
# 자동 조회 주기(분). 기본 30분, 최소 10분
# NHN_SYNC_INTERVAL_MIN=30
