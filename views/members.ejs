<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '담당자별 통계 - 관리자' }) %>
</head>
<body>
  <div class="wrap-wide">
    <div class="brand">
      <span class="dot">C</span>
      <span class="name">발신 번호 등록 관리자</span>
      <span class="sub">발신번호 등록 · 관리자</span>
      <span class="userbar">
        <span class="who"><%= currentUser ? currentUser.name : '' %></span>
        <a class="btn btn-ghost btn-sm" href="/admin">← 대시보드</a>
        <a class="btn btn-ghost btn-sm" href="/admin/activity">활동 로그</a>
        <a class="btn btn-ghost btn-sm" href="/auth/logout">로그아웃</a>
      </span>
    </div>

    <div class="card" style="margin-bottom:16px;">
      <p class="eyebrow">담당자별 통계</p>
      <h1 class="title" style="font-size:19px;">누가 얼마나 처리했나</h1>
      <p class="lead">담당자별 처리 실적입니다. 등록완료·거부는 그 번호를 제출한 담당자 기준으로 집계됩니다.</p>
    </div>

    <div class="table-card">
      <% if (!stats || stats.length === 0) { %>
        <div class="empty">아직 기록된 활동이 없어요.</div>
      <% } else { %>
        <table class="alog" id="memberTable">
          <thead>
            <tr>
              <th>담당자</th>
              <th>NHN 제출</th>
              <th>등록완료</th>
              <th>거부</th>
              <th>링크 발급</th>
              <th>최근 활동</th>
              <th>상세 보기</th>
            </tr>
          </thead>
          <tbody>
            <% stats.forEach(function (u) { %>
              <tr>
                <td class="u"><%= u.name %></td>
                <td><%= u.submits %></td>
                <td style="color:#1C6B45;font-weight:600;"><%= u.registered %></td>
                <td style="color:#c0392b;font-weight:600;"><%= u.rejected %></td>
                <td><%= u.links %></td>
                <td class="t"><%= u.last_at || '-' %></td>
                <td>
                  <% if (u.email) { %>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                      <button type="button" class="btn btn-primary btn-sm mbtn" data-email="<%= u.email %>" data-name="<%= u.name %>" data-kind="stores">심사 매장</button>
                      <button type="button" class="btn btn-ghost btn-sm mbtn" data-email="<%= u.email %>" data-name="<%= u.name %>" data-kind="activity">활동 로그</button>
                    </div>
                  <% } else { %>-<% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <!-- 담당자 상세 팝업 -->
  <div id="mmOverlay" class="mm-overlay" aria-hidden="true">
    <div class="mm-modal" role="dialog" aria-modal="true" aria-labelledby="mmTitle">
      <div class="mm-head">
        <div>
          <div class="mm-eyebrow" id="mmEyebrow">담당자 상세</div>
          <h2 class="mm-title" id="mmTitle">—</h2>
        </div>
        <button type="button" class="mm-close" id="mmClose" aria-label="닫기">✕</button>
      </div>
      <div class="mm-body" id="mmBody"></div>
    </div>
  </div>

  <style>
    .mm-overlay{position:fixed;inset:0;background:rgba(20,16,14,.5);backdrop-filter:blur(2px);
      display:none;align-items:flex-start;justify-content:center;padding:5vh 16px;z-index:1000;overflow-y:auto;}
    .mm-overlay.open{display:flex;}
    .mm-modal{background:var(--card,#fff);border-radius:16px;width:100%;max-width:880px;
      box-shadow:0 24px 60px rgba(0,0,0,.28);overflow:hidden;animation:mmIn .16s ease-out;}
    @keyframes mmIn{from{transform:translateY(10px);opacity:0}to{transform:translateY(0);opacity:1}}
    .mm-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;
      padding:18px 22px;border-bottom:1px solid var(--line,#eee);}
    .mm-eyebrow{font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted,#8a8a8a);}
    .mm-title{font-size:18px;margin:2px 0 0;font-weight:700;}
    .mm-close{border:none;background:transparent;font-size:18px;cursor:pointer;color:var(--muted,#888);
      line-height:1;padding:6px;border-radius:8px;}
    .mm-close:hover{background:var(--brand-soft,#f4f4f4);}
    .mm-body{padding:14px 22px 22px;max-height:70vh;overflow-y:auto;}
    .mm-body table{width:100%;border-collapse:collapse;font-size:13px;}
    .mm-body th,.mm-body td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line,#efefef);vertical-align:top;}
    .mm-body th{font-size:11px;color:var(--muted,#888);font-weight:600;text-transform:uppercase;letter-spacing:.03em;}
    .mm-body tr:last-child td{border-bottom:none;}
    .mm-empty{padding:28px 8px;text-align:center;color:var(--muted,#999);}
    .mm-loading{padding:28px 8px;text-align:center;color:var(--muted,#999);}
    .mm-badge{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600;white-space:nowrap;}
    .mm-badge.ok{background:#E4F5EC;color:#12543A;}
    .mm-badge.no{background:#FCE7E5;color:#A3231C;}
    .mm-badge.wait{background:#FFF3DC;color:#8a5a00;}
    .mm-badge.unk{background:#EEF1F4;color:#3E4A59;}
    .mm-reason{color:#A3231C;font-size:12px;margin-top:3px;}
    .mm-muted{color:var(--muted,#999);}
  </style>
  <script>
    (function () {
      var overlay = document.getElementById('mmOverlay');
      var body = document.getElementById('mmBody');
      var titleEl = document.getElementById('mmTitle');
      var eyebrowEl = document.getElementById('mmEyebrow');

      function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

      function open(){ overlay.classList.add('open'); overlay.setAttribute('aria-hidden','false'); }
      function close(){ overlay.classList.remove('open'); overlay.setAttribute('aria-hidden','true'); body.innerHTML=''; }

      document.getElementById('mmClose').addEventListener('click', close);
      overlay.addEventListener('click', function(e){ if(e.target === overlay) close(); });
      document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('open')) close(); });

      function statusBadge(s){
        var t = (s || '').toString();
        if (t === 'registered')  return '<span class="mm-badge ok">등록완료</span>';
        if (t === 'rejected')    return '<span class="mm-badge no">거부</span>';
        if (t === 'unconfirmed') return '<span class="mm-badge unk">승인 미확인</span>';
        if (t === 'requested')   return '<span class="mm-badge wait">심사중</span>';
        if (!t) return '<span class="mm-muted">미제출</span>';
        // 혹시 모를 기타 값은 한글이면 그대로, 아니면 그대로 표시
        if (t.indexOf('등록완료') >= 0 || t.indexOf('승인') >= 0) return '<span class="mm-badge ok">'+esc(t)+'</span>';
        if (t.indexOf('거부') >= 0 || t.indexOf('반려') >= 0) return '<span class="mm-badge no">'+esc(t)+'</span>';
        return '<span class="mm-badge wait">'+esc(t)+'</span>';
      }

      function renderStores(d){
        var rows = d.stores || [];
        if (!rows.length) return '<div class="mm-empty">심사 요청한 매장이 없어요.</div>';
        var h = '<table><thead><tr><th>매장</th><th>발신번호</th><th>상태</th><th>최근 조회</th></tr></thead><tbody>';
        rows.forEach(function(r){
          var reason = (r.nhn_reject_reason) ? '<div class="mm-reason">사유: '+esc(r.nhn_reject_reason)+'</div>' : '';
          h += '<tr><td><b>'+esc(r.store_name || r.name || '-')+'</b></td>'
             + '<td>'+esc(r.phone_numbers || r.contact_phone || '-')+'</td>'
             + '<td>'+statusBadge(r.nhn_status)+reason+'</td>'
             + '<td class="mm-muted">'+esc(r.nhn_checked_at || '-')+'</td></tr>';
        });
        return h + '</tbody></table>';
      }

      function renderActivity(d){
        var rows = d.entries || [];
        if (!rows.length) return '<div class="mm-empty">기록된 활동이 없어요.</div>';
        var h = '<table><thead><tr><th>시각</th><th>작업</th><th>매장</th><th>비고</th></tr></thead><tbody>';
        rows.forEach(function(r){
          h += '<tr><td class="mm-muted" style="white-space:nowrap;">'+esc(r.created_at || '-')+'</td>'
             + '<td>'+esc(r.action || '-')+'</td>'
             + '<td>'+esc(r.store_name || '-')+'</td>'
             + '<td class="mm-muted">'+esc(r.detail || '')+'</td></tr>';
        });
        return h + '</tbody></table>';
      }

      function load(email, name, kind){
        titleEl.textContent = name || email;
        eyebrowEl.textContent = (kind === 'activity') ? '활동 로그' : '심사 요청 매장';
        body.innerHTML = '<div class="mm-loading">불러오는 중…</div>';
        open();
        var url = (kind === 'activity')
          ? '/admin/api/member-activity?email=' + encodeURIComponent(email)
          : '/admin/api/member-stores?email=' + encodeURIComponent(email);
        fetch(url, { headers: { 'Accept': 'application/json' } })
          .then(function(r){ return r.json(); })
          .then(function(d){
            if (!d || d.ok === false) { body.innerHTML = '<div class="mm-empty">불러오지 못했어요.</div>'; return; }
            if (d.name) titleEl.textContent = d.name;
            body.innerHTML = (kind === 'activity') ? renderActivity(d) : renderStores(d);
          })
          .catch(function(){ body.innerHTML = '<div class="mm-empty">오류가 발생했어요. 잠시 후 다시 시도해주세요.</div>'; });
      }

      Array.prototype.forEach.call(document.querySelectorAll('.mbtn'), function(btn){
        btn.addEventListener('click', function(){
          load(btn.dataset.email, btn.dataset.name, btn.dataset.kind);
        });
      });
    })();
  </script>
</body>
</html>
