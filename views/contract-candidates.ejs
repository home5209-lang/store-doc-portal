<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '계약서 후보 선택 - ' + store.name }) %>
</head>
<body>
  <div class="wrap-wide" style="max-width:820px;">
    <div class="brand">
      <span class="dot">C</span>
      <span class="name">발신 번호 등록 관리자</span>
      <span class="sub">발신번호 등록 · 관리자</span>
    </div>

    <div style="margin-bottom:14px;"><a href="/admin">← 관리자 화면으로</a></div>

    <div class="card">
      <p class="eyebrow">계약서 후보 선택</p>
      <h1 class="title" style="font-size:20px;"><%= store.name %></h1>
      <p class="lead">모두싸인에서 검색어와 매칭된 서명 완료 계약서입니다. 알맞은 계약서(예: 이용계약서)를 골라 첨부하세요. 다시 선택하면 교체됩니다. 모두싸인에 없으면 아래에서 파일을 직접 올릴 수 있어요.</p>

      <% if (current) { %>
        <div class="alert" style="background:var(--success-bg);color:var(--success);margin-top:16px;">현재 첨부된 계약서: <%= current.original_name %></div>
      <% } %>

      <form class="inline-form" method="GET" action="/admin/contract-candidates/<%= store.id %>" style="margin-top:16px;">
        <input class="input" type="text" name="q" value="<%= query %>" placeholder="계약서 검색용 매장명 (오타/표기가 다르면 여기서 고쳐 검색)" />
        <button class="btn btn-primary" type="submit">검색</button>
      </form>
    </div>

    <div id="candArea" style="margin-top:16px;">
      <div class="table-card"><div class="empty" id="candLoading">
        <span class="spin" aria-hidden="true"></span> 모두싸인에서 계약서를 불러오는 중…
      </div></div>
    </div>

    <div class="card" style="margin-top:16px;">
      <p class="eyebrow">계약서 직접 첨부</p>
      <h2 class="title" style="font-size:16px;">모두싸인에 없는 계약서인가요?</h2>
      <p class="lead">계약서 파일(PDF 등)을 직접 올려 첨부할 수 있습니다. 올리면 기존 계약서는 교체됩니다.</p>
      <form method="POST" action="/admin/attach-contract-file/<%= store.id %>" enctype="multipart/form-data" style="margin-top:14px;">
        <label class="up">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </span>
          <span class="meta">
            <span class="t">계약서 파일</span>
            <span class="d">PDF 권장 (이미지·문서 파일도 가능)</span>
            <span class="fname"></span>
          </span>
          <span class="pill">파일 선택</span>
          <input type="file" name="contract_file" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" required />
        </label>
        <button class="btn btn-primary btn-block" type="submit" style="margin-top:16px;">이 파일로 첨부</button>
      </form>
    </div>
  </div>

  <style>
    .spin{display:inline-block;width:15px;height:15px;border:2px solid var(--border);border-top-color:var(--brand);border-radius:50%;vertical-align:-2px;margin-right:6px;animation:spin .8s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}
  </style>
  <script>
    (function () {
      var STORE_ID = '<%= store.id %>';
      var QUERY = <%- JSON.stringify(query) %>;
      var area = document.getElementById('candArea');
      function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

      function renderEmpty(){
        area.innerHTML = '<div class="table-card"><div class="empty">"' + esc(QUERY) + '" 와(과) 매칭되는 서명 완료 계약서를 찾지 못했습니다.<br>위 검색창에서 매장명 표기를 바꿔 다시 검색해보세요.</div></div>';
      }
      function renderError(msg){
        area.innerHTML = '<div class="alert alert-error">계약서 후보를 불러오지 못했습니다: ' + esc(msg) + '</div>';
      }
      function card(c){
        var score = (typeof c.score === 'number') ? c.score.toFixed(3) : '-';
        var signers = (c.signers && c.signers.length) ? c.signers.join(', ') : '-';
        var matched = c.matchedField === 'title' ? '제목' : (c.matchedField === 'participant' ? '서명자' : '-');
        var created = c.createdAt ? ('생성: ' + esc(c.createdAt) + ' · ') : '';
        return '<div class="cand">'
          + '<div>'
          +   '<p class="c-title">' + esc(c.title || '(제목 없음)') + '<span class="score">유사도 ' + score + '</span></p>'
          +   '<div class="c-meta">서명자: ' + esc(signers) + '<br>' + created + '매칭: ' + matched + '</div>'
          + '</div>'
          + '<div style="display:flex;gap:8px;align-items:center;">'
          +   '<a class="btn btn-ghost btn-sm" href="/admin/candidate-preview/' + STORE_ID + '/' + encodeURIComponent(c.documentId) + '" target="_blank" rel="noopener">미리보기</a>'
          +   '<form method="POST" action="/admin/attach-contract/' + STORE_ID + '">'
          +     '<input type="hidden" name="documentId" value="' + esc(c.documentId) + '">'
          +     '<input type="hidden" name="title" value="' + esc(c.title) + '">'
          +     '<button type="submit" class="btn btn-primary btn-sm">이 계약서 첨부</button>'
          +   '</form>'
          + '</div>'
          + '</div>';
      }

      fetch('/admin/contract-candidates/' + STORE_ID + '/data?q=' + encodeURIComponent(QUERY))
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res.ok) return renderError(res.error || '오류');
          if (!res.candidates || !res.candidates.length) return renderEmpty();
          area.innerHTML = res.candidates.map(card).join('');
        })
        .catch(function (e) { renderError(e.message); });
    })();

    document.querySelectorAll('.up input[type=file]').forEach(function (input) {
      input.addEventListener('change', function () {
        var tile = input.closest('.up');
        var fname = tile.querySelector('.fname');
        var pill = tile.querySelector('.pill');
        if (input.files && input.files.length) {
          tile.classList.add('filled');
          fname.textContent = '✓ ' + input.files[0].name;
          if (pill) pill.textContent = '변경';
        } else {
          tile.classList.remove('filled');
          fname.textContent = '';
          if (pill) pill.textContent = '파일 선택';
        }
      });
    });
  </script>
</body>
</html>
