<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '발신번호 등록 관리자' }) %>
</head>
<body>
  <div class="wrap-wide">
    <div class="brand">
      <span class="dot">C</span>
      <span class="name">발신 번호 등록 관리자</span>
      <span class="sub" style="display:flex;align-items:center;gap:10px;">
        발신번호 등록 · 관리자
        <button type="button" class="btn btn-ghost btn-sm" onclick="openGuide()">❔ 사용 가이드</button>
        <button type="button" class="btn btn-ghost btn-sm" onclick="openReject()">⚠ 반려 사유 안내</button>
      </span>
      <span class="userbar">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <span class="who"><%= currentUser.name %></span>
        <% } %>
        <a class="btn btn-ghost btn-sm" href="/admin/members">담당자별 통계</a>
        <a class="btn btn-ghost btn-sm" href="/admin/activity">활동 로그</a>
        <a class="btn btn-ghost btn-sm" href="/auth/logout">로그아웃</a>
      </span>
    </div>

    <%
      const types = Object.values(docTypes);
      const hasDoc = (store, t) => store.documents.some(d => d.doc_type === t);
      const docOf = (store, t) => store.documents.find(d => d.doc_type === t);
      const readyCount = (store) => types.filter(t => hasDoc(store, t)).length;
      const isReady = (store) => readyCount(store) === types.length;
      const m = { total: stores.length, wait: 0, review: 0, done: 0 };
      stores.forEach(s => {
        if (s.nhn_status === 'registered') m.done += 1;
        else if (s.nhn_status === 'requested') m.review += 1;
        else if (!isReady(s)) m.wait += 1;
      });
    %>

    <% if (typeof nhnLoggedIn !== 'undefined' && !nhnLoggedIn) { %>
      <div class="nhn-login-banner off">
        <span class="ic">⚠</span>
        <div>
          <b>NHN에 로그인되어 있지 않습니다.</b>
          <div class="sub">발신번호 등록 신청을 하려면 <b>로그인.bat</b>을 실행해 <b>본인 NHN 계정</b>으로 먼저 로그인해주세요.</div>
        </div>
      </div>
    <% } else if (typeof nhnLoggedIn !== 'undefined') { %>
      <div class="nhn-login-banner on">
        <span class="ic">✓</span>
        <div><b>NHN 로그인됨</b> <span class="sub">— 세션이 만료되면 로그인.bat으로 본인 계정 재로그인이 필요할 수 있어요.</span></div>
      </div>
    <% } %>

    <style>
      .nhn-login-banner{display:flex;align-items:flex-start;gap:10px;border-radius:12px;padding:12px 15px;margin-bottom:14px;font-size:13px;}
      .nhn-login-banner .ic{font-size:15px;flex:0 0 auto;line-height:1.4;}
      .nhn-login-banner .sub{color:var(--muted);font-size:12px;}
      .nhn-login-banner.off{background:var(--brand-soft);border:1px solid #F3C2BE;color:#A3231C;}
      .nhn-login-banner.off .sub{color:#8a4b45;}
      .nhn-login-banner.on{background:var(--success-bg);border:1px solid #BFE3CF;color:#12543A;}
    </style>

    <div class="card" style="margin-bottom:16px;">
      <p class="eyebrow">업로드 링크 발급</p>
      <h1 class="title" style="font-size:19px;">매장별 진행 현황</h1>
      <p class="lead">매장 시퀀스넘버를 입력하면 캐치테이블 어드민에서 매장을 찾아줍니다. 목록에서 매장을 선택한 뒤 링크를 발급하세요.</p>

      <% if (createdLink) { %>
        <div class="banner" style="margin-top:16px;">🔗 새 업로드 링크: <%= createdLink %></div>
      <% } %>
      <% if (typeof linkError !== 'undefined' && linkError) { %>
        <div class="alert alert-error" style="margin-top:16px;"><%= linkError %></div>
      <% } %>

      <div class="combo" style="max-width:380px;margin-top:14px;">
        <input id="shopSearch" class="input" autocomplete="off" placeholder="매장명 또는 시퀀스넘버 검색" />
        <div id="shopResults" class="combo-list" style="display:none;"></div>
      </div>

      <form id="createForm" method="POST" action="/admin/create-link" style="margin-top:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <input type="hidden" name="shop_seq" id="selSeq" />
        <span id="selLabel" style="font-size:13px;color:var(--muted);">위에서 매장을 검색해 선택하세요.</span>
        <button class="btn btn-primary" type="submit" id="createBtn" disabled>링크 발급</button>
      </form>

      <style>
        .combo{position:relative;}
        .combo-list{position:absolute;left:0;right:0;top:calc(100% + 4px);background:#fff;border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow);z-index:20;overflow:hidden;}
        .combo-item{padding:11px 14px;font-size:13.5px;cursor:pointer;display:flex;align-items:center;gap:8px;}
        .combo-item:hover,.combo-item.active{background:var(--brand-soft);}
        .combo-item .seq{color:var(--muted);font-size:12px;}
        .combo-empty{padding:11px 14px;font-size:12.5px;color:var(--muted);}
        .combo-picked{color:var(--text);font-weight:600;}
      </style>
      <script>
        (function(){
          var input=document.getElementById('shopSearch');
          var list=document.getElementById('shopResults');
          var selSeq=document.getElementById('selSeq');
          var selLabel=document.getElementById('selLabel');
          var btn=document.getElementById('createBtn');
          var timer=null, lastQuery='';

          function hide(){ list.style.display='none'; list.innerHTML=''; }
          function clearSel(){ selSeq.value=''; btn.disabled=true; selLabel.textContent='위에서 매장을 검색해 선택하세요.'; selLabel.className=''; selLabel.style.color='var(--muted)'; }

          function pick(id, name){
            selSeq.value=id;
            selLabel.textContent='선택됨: '+name+' ('+id+')';
            selLabel.className='combo-picked'; selLabel.style.color='var(--text)';
            btn.disabled=false;
            input.value=name+' ('+id+')';
            hide();
          }

          function render(items){
            list.innerHTML='';
            if(!items || !items.length){ list.innerHTML='<div class="combo-empty">일치하는 매장이 없습니다.</div>'; list.style.display='block'; return; }
            items.forEach(function(it){
              var d=document.createElement('div'); d.className='combo-item';
              d.innerHTML='<span class="nm"></span> <span class="seq"></span>';
              d.querySelector('.nm').textContent=it.name;
              d.querySelector('.seq').textContent='('+it.id+')';
              d.addEventListener('mousedown', function(e){ e.preventDefault(); pick(it.id, it.name); });
              list.appendChild(d);
            });
            list.style.display='block';
          }

          function lookup(q){
            list.innerHTML='<div class="combo-empty">검색 중…</div>'; list.style.display='block';
            fetch('/admin/shop-lookup?q='+encodeURIComponent(q))
              .then(function(r){return r.json();})
              .then(function(res){
                if(input.value.trim()!==q) return; // 입력이 바뀌었으면 무시
                if(res.ok) render(res.items);
                else { list.innerHTML='<div class="combo-empty">'+(res.error||'조회 실패')+'</div>'; list.style.display='block'; }
              })
              .catch(function(){ list.innerHTML='<div class="combo-empty">조회 중 오류가 발생했습니다.</div>'; list.style.display='block'; });
          }

          input.addEventListener('input', function(){
            clearSel();
            var q=input.value.trim();
            if(timer) clearTimeout(timer);
            if(q.length < 1){ hide(); return; }
            timer=setTimeout(function(){ lookup(q); }, 300);
          });
          input.addEventListener('focus', function(){ if(list.innerHTML) list.style.display='block'; });
          document.addEventListener('click', function(e){ if(!e.target.closest('.combo')) hide(); });

          document.getElementById('createForm').addEventListener('submit', function(e){
            if(!selSeq.value){ e.preventDefault(); alert('먼저 매장을 검색해 선택해주세요.'); }
          });
        })();
      </script>

      <div style="margin-top:12px;display:flex;align-items:center;gap:10px;">
        <form method="POST" action="/admin/nhn-sync" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='조회 중…';">
          <button class="btn btn-ghost btn-sm" type="submit">↻ NHN 심사 상태 새로고침</button>
        </form>
        <span class="hint" style="margin:0;">심사 상태는 30분마다 자동 갱신됩니다.</span>
      </div>
    </div>

    <div class="metrics">
      <div class="metric"><div class="k">전체 매장</div><div class="v"><%= m.total %></div></div>
      <div class="metric"><div class="k">서류 대기</div><div class="v warn"><%= m.wait %></div></div>
      <div class="metric"><div class="k">심사중</div><div class="v acc"><%= m.review %></div></div>
      <div class="metric"><div class="k">등록완료</div><div class="v ok"><%= m.done %></div></div>
    </div>

    <% if (stores.length === 0) { %>
      <div class="table-card"><div class="empty">아직 제출된 매장이 없어요.</div></div>
    <% } else { %>
    <div class="filters">
      <input id="storeSearch" class="input" type="text" placeholder="매장명 검색" />
      <div class="fchips">
        <button type="button" class="fchip active" data-f="all">전체</button>
        <button type="button" class="fchip" data-f="wait">서류 대기</button>
        <button type="button" class="fchip" data-f="ready">신청 대기</button>
        <button type="button" class="fchip" data-f="review">심사중</button>
        <button type="button" class="fchip" data-f="done">등록완료</button>
        <button type="button" class="fchip" data-f="rejected">거부</button>
      </div>
      <select id="storeSort" class="fsort">
        <option value="default">등록순(최신)</option>
        <option value="name">매장명순</option>
        <option value="status">상태순</option>
      </select>
    </div>
    <div class="table-card" id="storeList">
      <% stores.forEach(store => {
           const ready = isReady(store);
           const count = readyCount(store);
           const st = store.nhn_status === 'registered' ? 'done'
             : store.nhn_status === 'rejected' ? 'rejected'
             : store.nhn_status === 'requested' ? 'review'
             : (ready ? 'ready' : 'wait');
      %>
        <div class="srow" data-status="<%= st %>" data-name="<%= (store.name || '').toLowerCase() %>">
          <div class="info">
            <div class="nm"><%= store.name %></div>
            <div class="sub"><%= store.owner_name || '대표자 미입력' %><% if (store.phone_numbers) { %> · <%= store.phone_numbers %><% } %></div>
            <div class="dots" style="margin-top:9px;" title="서류 <%= count %>/<%= types.length %>">
              <% types.forEach(t => { %><span class="dot <%= hasDoc(store, t) ? 'on' : 'off' %>"></span><% }) %>
              <span style="font-size:12px;color:var(--muted);margin-left:6px;">서류 <%= count %>/<%= types.length %></span>
            </div>
            <% var la = (typeof lastActor !== 'undefined' && lastActor) ? lastActor[store.id] : null; %>
            <% if (la) { %>
              <div class="actor">최근: <b><%= la.user_name || la.user_email %></b> · <%= la.action %> · <%= la.created_at %></div>
            <% } %>
          </div>

          <div class="actions-col">
            <% if (store.nhn_status === 'registered') { %>
              <span class="nhn-stat done"><span class="dot"></span>등록완료</span>
            <% } else if (store.nhn_status === 'rejected') { %>
              <span class="nhn-stat rejected"><span class="dot"></span>거부</span>
              <% if (store.nhn_reject_reason) { %>
                <span class="reject-reason">사유: <%= store.nhn_reject_reason %></span>
              <% } else { %>
                <span class="reject-reason">반려되었습니다. NHN 콘솔·이메일에서 반려 사유를 확인 후 서류를 교체해 재신청해주세요.</span>
              <% } %>
              <form method="POST" action="/admin/nhn-submit/<%= store.id %>" onsubmit="return confirm('서류를 다시 검토하셨나요? NHN에 재신청합니다.');">
                <button type="submit" class="btn btn-ghost btn-sm">재신청</button>
              </form>
            <% } else if (store.nhn_status === 'requested') { %>
              <span class="nhn-stat review"><span class="dot"></span>심사중</span>
            <% } else if (ready) { %>
              <form method="POST" action="/admin/nhn-submit/<%= store.id %>" onsubmit="return confirm('서류를 검토하셨나요? NHN에 발신번호 등록을 신청합니다.');">
                <button type="submit" class="btn btn-primary btn-sm">NHN 등록 신청</button>
              </form>
            <% } else { %>
              <span class="badge gray">서류 대기중</span>
            <% } %>
            <% if (store.nhn_checked_at) { %><span class="checked-at">조회: <%= store.nhn_checked_at %></span><% } %>
            <div style="display:flex;gap:7px;">
              <button type="button" class="btn btn-ghost btn-sm" onclick="openDocs('<%= store.id %>')">서류 보기</button>
              <form method="POST" action="/admin/create-link">
                <input type="hidden" name="storeId" value="<%= store.id %>" />
                <button type="submit" class="btn btn-ghost btn-sm">새 링크</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
      <div class="filters-empty" id="filterEmpty">조건에 맞는 매장이 없어요.</div>
    </div>
    <% } %>
  </div>

  <% stores.forEach(store => {
       const count = readyCount(store);
  %>
    <div class="modal-overlay" id="m-<%= store.id %>">
      <div class="modal" role="dialog" aria-modal="true" aria-label="<%= store.name %> 제출 서류">
        <div class="mhead">
          <div>
            <div class="mt"><%= store.name %></div>
            <div class="msub">제출 서류 · <%= count %>/<%= types.length %> 준비됨</div>
          </div>
          <button class="mclose" type="button" onclick="closeDocs('<%= store.id %>')" aria-label="닫기">✕</button>
        </div>
        <div class="mbody">
          <% types.forEach(t => {
               const doc = docOf(store, t);
               const isContract = (t === docTypes.CONTRACT);
          %>
            <div class="docrow">
              <% if (doc) { %>
                <span class="dname"><span class="doc-check" aria-label="첨부됨">✓</span><%= t %></span>
                <span class="acts">
                  <a class="prev" href="/admin/view/<%= store.id %>/<%= doc.id %>" target="_blank" rel="noopener">미리보기</a>
                  <% if (isContract) { %>
                    <a class="link-strong" href="/admin/contract-candidates/<%= store.id %>">다시 선택</a>
                  <% } else { %>
                    <form method="POST" action="/admin/replace-doc/<%= store.id %>" enctype="multipart/form-data" style="display:inline;margin:0;">
                      <input type="hidden" name="doc_type" value="<%= t %>" />
                      <label class="link-strong" style="cursor:pointer;">다시 선택<input type="file" name="doc_file" style="display:none;" onchange="this.form.submit()" /></label>
                    </form>
                  <% } %>
                  <a href="/admin/download/<%= store.id %>/<%= doc.id %>" title="다운로드" aria-label="다운로드"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></a>
                </span>
              <% } else if (isContract) { %>
                <span class="missing"><%= t %></span>
                <span class="acts"><a class="link-strong" href="/admin/contract-candidates/<%= store.id %>">후보 선택 / 직접 첨부 →</a></span>
              <% } else { %>
                <span class="missing"><%= t %></span>
                <span class="acts"><span class="missing">매장 업로드 대기</span></span>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% }) %>

  <%- include('partials/guide') %>

  <!-- NHN 반려 사유 안내 -->
  <div class="modal-overlay" id="reject-guide">
    <div class="modal wide" role="dialog" aria-modal="true" aria-label="NHN 반려 사유 안내">
      <div class="mhead">
        <div>
          <div class="mt">⚠ NHN 반려 사유 안내</div>
          <div class="msub">NHN에서 제공한 심사 반려 기준입니다. 매장에 안내하거나 제출 전 확인하세요.</div>
        </div>
        <button class="mclose" type="button" onclick="closeReject()" aria-label="닫기">✕</button>
      </div>
      <div class="mbody">
        <div class="rej-block rej-common">
          <div class="rej-h">📌 공통 (모든 서류)</div>
          <ul>
            <li><b>발급 3개월 이내</b> — 관계확인증명서·사업자등록증을 제외한 모든 서류는 최근 3개월 이내 발급본이어야 합니다.</li>
            <li><b>마스킹 금지</b> — 주민등록번호 뒷자리를 제외하고는 어떤 정보도 가리면(마스킹) 반려됩니다.</li>
            <li><b>정보 일치</b> — 모든 서류의 상호명·대표자·사업자번호가 사업자등록증과 동일해야 합니다.</li>
          </ul>
        </div>
        <div class="rej-block">
          <div class="rej-h">📄 통신서비스 이용증명원</div>
          <ul>
            <li>발급자 정보·전화번호가 <b>없거나 마스킹</b>되어 있으면 반려됩니다.</li>
            <li>신청한 <b>전화번호 목록과 모두 일치</b>해야 합니다.</li>
          </ul>
        </div>
        <div class="rej-block">
          <div class="rej-h">📄 사업자등록증</div>
          <ul>
            <li><b>주민등록번호 뒷자리만</b> 가리고, 나머지는 가리지 않고 제출합니다.</li>
          </ul>
        </div>
        <div class="rej-block">
          <div class="rej-h">📄 재직증명서</div>
          <ul>
            <li><b>주민등록번호 뒷자리가 노출</b>되면 반려됩니다. (본 툴 생성본은 주민번호를 넣지 않습니다)</li>
          </ul>
        </div>
        <div class="rej-block">
          <div class="rej-h">📄 관계확인증명서</div>
          <ul>
            <li>발신번호 명의자·계정 명의자 <b>양사 직인 날인</b>이 필수입니다.</li>
          </ul>
        </div>
        <p class="rej-source">※ 위 기준은 NHN에서 제공한 심사 반려 기준입니다.</p>
      </div>
    </div>
  </div>

  <style>
    .rej-block{padding:12px 0;border-bottom:1px solid var(--border);}
    .rej-block:last-child{border-bottom:none;}
    .rej-block.rej-common{background:var(--warn-bg);border:1px solid #E7D6A6;border-radius:10px;padding:12px 14px;margin-bottom:6px;}
    .rej-h{font-size:14px;font-weight:800;color:#1F1D1B;margin-bottom:7px;}
    .rej-block ul{margin:0;padding-left:18px;}
    .rej-block li{font-size:13px;color:#4A4844;line-height:1.65;margin-bottom:5px;}
    .rej-block b{color:#B3261E;}
    .rej-block.rej-common b{color:#7A5A12;}
    .rej-source{font-size:12px;color:var(--muted);margin:14px 0 0;padding-top:10px;border-top:1px solid var(--border);}
  </style>

  <script>
    function openDocs(id) { var o = document.getElementById('m-' + id); if (o) o.classList.add('open'); }
    function closeDocs(id) { var o = document.getElementById('m-' + id); if (o) o.classList.remove('open'); }
    function openGuide() { var o = document.getElementById('guide-modal'); if (o) o.classList.add('open'); }
    function closeGuide() { var o = document.getElementById('guide-modal'); if (o) o.classList.remove('open'); }
    function openReject() { var o = document.getElementById('reject-guide'); if (o) o.classList.add('open'); }
    function closeReject() { var o = document.getElementById('reject-guide'); if (o) o.classList.remove('open'); }
    document.querySelectorAll('.modal-overlay').forEach(function (o) {
      o.addEventListener('click', function (e) { if (e.target === o) o.classList.remove('open'); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open, .guide-drawer.open').forEach(function (o) { o.classList.remove('open'); });
    });

    // 매장 검색 · 상태 필터 · 정렬 (클라이언트)
    (function () {
      var list = document.getElementById('storeList');
      if (!list) return;
      var search = document.getElementById('storeSearch');
      var chips = document.querySelectorAll('.fchip');
      var sortSel = document.getElementById('storeSort');
      var emptyEl = document.getElementById('filterEmpty');
      var rows = Array.prototype.slice.call(list.querySelectorAll('.srow'));
      var origOrder = rows.slice();
      var curFilter = 'all';
      var statusRank = { rejected: 0, review: 1, ready: 2, wait: 3, done: 4 };

      function apply() {
        var q = (search && search.value || '').trim().toLowerCase();
        var shown = 0;
        rows.forEach(function (r) {
          var okF = curFilter === 'all' || r.getAttribute('data-status') === curFilter;
          var okQ = !q || (r.getAttribute('data-name') || '').indexOf(q) >= 0;
          var show = okF && okQ;
          r.style.display = show ? '' : 'none';
          if (show) shown += 1;
        });
        if (emptyEl) emptyEl.style.display = shown === 0 ? 'block' : 'none';
      }
      function sortRows() {
        var mode = sortSel ? sortSel.value : 'default';
        var arr = origOrder.slice();
        if (mode === 'name') {
          arr.sort(function (a, b) { return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '', 'ko'); });
        } else if (mode === 'status') {
          arr.sort(function (a, b) { return (statusRank[a.getAttribute('data-status')] || 9) - (statusRank[b.getAttribute('data-status')] || 9); });
        }
        arr.forEach(function (r) { list.appendChild(r); });
      }
      if (search) search.addEventListener('input', apply);
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          chips.forEach(function (x) { x.classList.remove('active'); });
          c.classList.add('active');
          curFilter = c.getAttribute('data-f');
          apply();
        });
      });
      if (sortSel) sortSel.addEventListener('change', function () { sortRows(); apply(); });
    })();
  </script>
</body>
</html>
