<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '발신번호 등록 관리자' }) %>
</head>
<body>
  <div class="wrap-wide">
    <div class="brand">
      <span class="dot">C</span>
      <span class="name">캐치테이블</span>
      <span class="sub">발신번호 등록 · 관리자</span>
    </div>

    <div class="card" style="margin-bottom:18px;">
      <p class="eyebrow">업로드 링크 발급</p>
      <h1 class="title" style="font-size:19px;">매장별 진행 현황</h1>
      <p class="lead">캐치테이블 어드민 기준 매장명을 입력해 만료되는 업로드 링크를 발급하세요.</p>

      <% if (createdLink) { %>
        <div class="banner" style="margin-top:16px;">🔗 새 업로드 링크: <%= createdLink %></div>
      <% } %>

      <form class="inline-form" method="POST" action="/admin/create-link" style="margin-top:14px;">
        <input class="input" type="text" name="name" placeholder="매장명 (캐치테이블 어드민 기준)" />
        <button class="btn btn-primary" type="submit">링크 발급</button>
      </form>
    </div>

    <% if (stores.length === 0) { %>
      <div class="table-card"><div class="empty">아직 제출된 매장이 없어요.</div></div>
    <% } else { %>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>매장명</th>
            <th>대표자</th>
            <th>상태</th>
            <th>제출일</th>
            <th>서류</th>
            <th>NHN 심사</th>
            <th>링크</th>
          </tr>
        </thead>
        <tbody>
          <% stores.forEach(store => {
               const allReady = Object.values(docTypes).every(t => store.documents.some(d => d.doc_type === t));
          %>
            <tr>
              <td><span class="name-strong"><%= store.name %></span></td>
              <td><%= store.owner_name || '-' %></td>
              <td><span class="status <%= store.status %>"><%= store.status === 'submitted' ? '제출완료' : '대기중' %></span></td>
              <td style="color:var(--muted);"><%= store.submitted_at || '-' %></td>
              <td>
                <div class="doclist">
                  <% Object.values(docTypes).forEach(type => {
                       const doc = store.documents.find(d => d.doc_type === type);
                       const isContract = (type === docTypes.CONTRACT);
                  %>
                    <% if (doc) { %>
                      <a href="/admin/download/<%= store.id %>/<%= doc.id %>"><%= type %> ↓</a>
                      <% if (isContract) { %>
                        <a class="link-strong" href="/admin/contract-candidates/<%= store.id %>">↻ 다시 선택</a>
                      <% } %>
                    <% } else if (isContract) { %>
                      <a class="link-strong" href="/admin/contract-candidates/<%= store.id %>"><%= type %> — 후보 선택 →</a>
                    <% } else { %>
                      <span class="missing"><%= type %> (대기)</span>
                    <% } %>
                  <% }) %>
                </div>
              </td>
              <td>
                <% if (store.nhn_status === 'registered') { %>
                  <span class="badge green">등록완료</span>
                <% } else if (store.nhn_status === 'requested') { %>
                  <span class="badge warn">신청함</span>
                <% } else if (allReady) { %>
                  <form method="POST" action="/admin/nhn-submit/<%= store.id %>" onsubmit="return confirm('서류를 검토하셨나요? NHN에 발신번호 등록을 신청합니다.');">
                    <button type="submit" class="btn btn-primary btn-sm">NHN 등록 신청</button>
                  </form>
                <% } else { %>
                  <span class="badge gray">서류 대기중</span>
                <% } %>
              </td>
              <td>
                <form method="POST" action="/admin/create-link">
                  <input type="hidden" name="storeId" value="<%= store.id %>" />
                  <button type="submit" class="btn btn-ghost btn-sm">새 링크</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</body>
</html>
