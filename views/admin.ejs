<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>발신번호 등록 관리자 화면</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    body { font-family: -apple-system, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif; background: #f5f5f4; margin: 0; padding: 24px; }
    h1 { font-size: 18px; margin: 0 0 16px; }
    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; }
    th, td { padding: 10px 12px; font-size: 13px; text-align: left; border-bottom: 1px solid #eeece7; vertical-align: top; }
    th { background: #f7f6f3; color: #55534f; font-weight: 500; }
    .status { padding: 3px 10px; border-radius: 6px; font-size: 12px; }
    .status.submitted { background: #e3f2e9; color: #1c6b45; }
    .status.pending { background: #f2ede1; color: #8a6a1f; }
    .doclist { display: flex; flex-direction: column; gap: 4px; }
    .doclist a { color: #1a56db; font-size: 12px; text-decoration: none; }
    .missing { color: #b5b2ab; font-size: 12px; }
    .empty { padding: 40px; text-align: center; color: #8a8a86; background: #fff; border-radius: 12px; }
    .new-link-form { display: flex; gap: 8px; margin-bottom: 16px; }
    .new-link-form input[type=text] { flex: 1; padding: 8px 10px; border: 1px solid #d8d6d0; border-radius: 6px; font-size: 13px; }
    .new-link-form button { padding: 8px 14px; border: none; border-radius: 6px; background: #1c1c1a; color: #fff; font-size: 13px; cursor: pointer; }
    .created-banner { background: #eaf1fb; color: #1a56db; padding: 10px 12px; border-radius: 8px; font-size: 12px; margin-bottom: 16px; word-break: break-all; }
    .relink-btn { border: none; background: none; color: #1a56db; font-size: 12px; cursor: pointer; padding: 0; text-decoration: underline; }
    .candidates-link { color: #1c6b45; font-size: 12px; text-decoration: none; margin-top: 4px; font-weight: 500; }
  </style>
</head>
<body>
  <h1>매장별 발신번호 등록 진행 현황</h1>

  <% if (createdLink) { %>
    <div class="created-banner">새 업로드 링크: <%= createdLink %></div>
  <% } %>

  <form class="new-link-form" method="POST" action="/admin/create-link">
    <input type="text" name="name" placeholder="새 매장명 (예: 캐치테이블 강남점)" />
    <button type="submit">업로드 링크 발급</button>
  </form>

  <% if (stores.length === 0) { %>
    <div class="empty">아직 제출된 매장이 없어요.</div>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>매장명</th>
        <th>대표자</th>
        <th>상태</th>
        <th>제출일</th>
        <th>서류</th>
        <th>업로드 링크</th>
      </tr>
    </thead>
    <tbody>
      <% stores.forEach(store => { %>
        <tr>
          <td><%= store.name %></td>
          <td><%= store.owner_name || '-' %></td>
          <td><span class="status <%= store.status %>"><%= store.status === 'submitted' ? '제출완료' : '대기중' %></span></td>
          <td><%= store.submitted_at || '-' %></td>
          <td>
            <div class="doclist">
              <% Object.values(docTypes).forEach(type => {
                   const doc = store.documents.find(d => d.doc_type === type);
                   const isContract = (type === docTypes.CONTRACT);
              %>
                <% if (doc) { %>
                  <a href="/admin/download/<%= store.id %>/<%= doc.id %>"><%= type %> ↓</a>
                  <% if (isContract) { %>
                    <a class="candidates-link" href="/admin/contract-candidates/<%= store.id %>">↻ 다시 선택</a>
                  <% } %>
                <% } else if (isContract) { %>
                  <a class="candidates-link" href="/admin/contract-candidates/<%= store.id %>"><%= type %> — 후보 선택 →</a>
                <% } else { %>
                  <span class="missing"><%= type %> (대기)</span>
                <% } %>
              <% }) %>
            </div>
          </td>
          <td>
            <form method="POST" action="/admin/create-link">
              <input type="hidden" name="storeId" value="<%= store.id %>" />
              <button type="submit" class="relink-btn">새 링크 발급</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</body>
</html>
