<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '발신번호 등록 서류 제출' }) %>
</head>
<body>
  <div class="wrap">
    <div class="brand">
      <span class="dot">C</span>
      <span class="name">발신 번호 등록 관리자</span>
      <span class="sub">발신번호 등록</span>
    </div>

    <div class="card">
      <p class="eyebrow">서류 제출</p>
      <h1 class="title"><%= store.name === '매장명 미입력' ? '매장 정보를 입력해주세요' : store.name %></h1>
      <p class="lead">아래 정보를 채우고 서류 4개를 올려주세요. 사용 승낙서와 재직 증명서는 제공되는 양식을 받아 작성·날인 후 올려주시면 됩니다.</p>

      <div class="steps" aria-hidden="true" style="margin-top:16px;">
        <span class="bar on"></span><span class="bar on"></span><span class="bar"></span>
      </div>
      <div class="steplabels">
        <span class="done">✓ 매장 정보</span>
        <span class="cur">서류 첨부</span>
        <span>제출 완료</span>
      </div>

      <% if (error) { %>
        <div class="alert alert-error" style="margin-top:16px;"><%= error %></div>
      <% } %>

      <form method="POST" enctype="multipart/form-data">
        <div class="field">
          <label>매장명 <span class="req">*</span></label>
          <input class="input" type="text" name="name" value="<%= store.name === '매장명 미입력' ? '' : store.name %>" required />
          <div class="hint">캐치테이블 어드민에 등록된 매장명과 동일하게 입력해주세요.</div>
        </div>

        <div class="field">
          <label>대표자명 <span class="req">*</span></label>
          <input class="input" type="text" name="owner_name" value="<%= store.owner_name || '' %>" required />
        </div>

        <div class="field">
          <label>사업자등록번호 <span class="req">*</span></label>
          <input class="input" type="text" name="biz_reg_no" value="<%= store.biz_reg_no || '' %>" placeholder="000-00-00000" required />
        </div>

        <div class="field">
          <label>등록할 발신번호(전화번호) <span class="req">*</span></label>
          <input class="input" type="text" name="phone_numbers" value="<%= store.phone_numbers || '' %>" placeholder="예: 02-1234-5678 (여러 개면 쉼표로 구분)" required />
          <div class="hint">사용 승낙서의 전화번호 목록에 그대로 기재됩니다.</div>
        </div>

        <div class="field">
          <label>대표자 직위 <span class="req">*</span></label>
          <input class="input" type="text" name="contact_title" value="<%= store.contact_title || '' %>" placeholder="예: 대표" required />
          <div class="hint">재직증명서에 대표자 직위로 기재됩니다. (모든 서류의 인적사항은 사업자등록증과 동일해야 합니다.)</div>
        </div>

        <hr class="divider" />

        <div class="count-callout">
          <span class="l">직접 올릴 서류</span>
          <span class="n"><span id="upcount">0</span> / 4 첨부</span>
        </div>

        <p class="section-label">첨부 서류 (4개)</p>

        <label class="up">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </span>
          <span class="meta">
            <span class="t">통신서비스 이용증명원 <span class="req">*</span></span>
            <span class="d">통신사에서 발급받은 파일 · 최근 3개월 이내</span>
            <span class="fname"></span>
          </span>
          <span class="pill">파일 선택</span>
          <input type="file" name="telecom_proof" required />
        </label>

        <label class="up">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
          <span class="meta">
            <span class="t">사업자 등록증 <span class="req">*</span></span>
            <span class="d">3개월 이내 발급본</span>
            <span class="fname"></span>
          </span>
          <span class="pill">파일 선택</span>
          <input type="file" name="biz_reg" required />
        </label>

        <label class="up">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
          <span class="meta">
            <span class="t">사용 승낙서 <span class="req">*</span></span>
            <span class="d">위 양식을 받아 작성 후 업로드</span>
            <span class="fname"></span>
          </span>
          <span class="pill">파일 선택</span>
          <input type="file" name="consent" required />
        </label>
        <div class="doc-actions">
          <a class="mini-btn" href="/upload/<%= store.id %>/<%= token %>/form/consent">⬇ 양식 받기</a>
          <button type="button" class="mini-btn ghost" data-ex="/examples/consent_example.png">🔍 작성 예시</button>
        </div>

        <label class="up">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
          <span class="meta">
            <span class="t">재직 증명서 <span class="req">*</span></span>
            <span class="d">위 양식을 받아 작성·날인(직인) 후 업로드</span>
            <span class="fname"></span>
          </span>
          <span class="pill">파일 선택</span>
          <input type="file" name="employment" required />
        </label>
        <div class="doc-actions">
          <a class="mini-btn" href="/upload/<%= store.id %>/<%= token %>/form/employment">⬇ 양식 받기</a>
          <button type="button" class="mini-btn ghost" data-ex="/examples/employment_example.png">🔍 작성 예시</button>
        </div>

        <div class="autobox">
          <p class="cap">캐치테이블 이용계약서는 담당자가 확인·첨부합니다 — 매장에서 올리실 필요 없어요.</p>
        </div>

        <button class="btn btn-primary btn-block" type="submit" style="margin-top:22px;">제출하기</button>
      </form>
    </div>
  </div>

  <style>
    .doc-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin:-6px 2px 2px;}
    .mini-btn{display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border:1px solid var(--brand,#FB6220);
      border-radius:9px;color:var(--brand,#FB6220);background:#fff;font-size:12.5px;font-weight:600;
      text-decoration:none;cursor:pointer;}
    .mini-btn:hover{background:var(--brand,#FB6220);color:#fff;}
    .mini-btn.ghost{color:#8a5a2a;border-color:#e3c9b3;}
    .mini-btn.ghost:hover{background:#8a5a2a;color:#fff;border-color:#8a5a2a;}
    .ex-overlay{position:fixed;inset:0;background:rgba(0,0,0,.62);display:none;
      align-items:flex-start;justify-content:center;z-index:1000;overflow:auto;padding:24px;}
    .ex-overlay.open{display:flex;}
    .ex-box{background:#fff;border-radius:14px;padding:14px;max-width:840px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.35);}
    .ex-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
    .ex-head .t{font-weight:700;font-size:14px;color:#222;}
    .ex-close{padding:8px 14px;border:1px solid #ddd;border-radius:8px;background:#fff;cursor:pointer;font-size:13px;}
    .ex-box img{width:100%;height:auto;display:block;border:1px solid #eee;border-radius:8px;}
  </style>

  <div id="exOverlay" class="ex-overlay" aria-hidden="true">
    <div class="ex-box">
      <div class="ex-head">
        <span class="t">작성 예시 (실제 정보로 채워 제출하세요)</span>
        <button type="button" id="exClose" class="ex-close">✕ 닫기</button>
      </div>
      <img id="exImg" src="" alt="작성 예시" />
    </div>
  </div>

  <script>
    // 예시 보기 팝업
    (function () {
      var overlay = document.getElementById('exOverlay');
      var img = document.getElementById('exImg');
      function openEx(src) { img.src = src; overlay.classList.add('open'); }
      function closeEx() { overlay.classList.remove('open'); img.src = ''; }
      document.querySelectorAll('[data-ex]').forEach(function (b) {
        b.addEventListener('click', function () { openEx(b.getAttribute('data-ex')); });
      });
      document.getElementById('exClose').addEventListener('click', closeEx);
      overlay.addEventListener('click', function (e) { if (e.target === overlay) closeEx(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeEx(); });
    })();

    // 업로드 타일: 파일 선택 시 파일명 표시 + 완료 상태 + 첨부 카운트 갱신
    var upInputs = document.querySelectorAll('.up input[type=file]');
    function refreshCount() {
      var n = 0;
      upInputs.forEach(function (i) { if (i.files && i.files.length) n += 1; });
      var el = document.getElementById('upcount');
      if (el) el.textContent = n;
    }
    upInputs.forEach(function (input) {
      input.addEventListener('change', function () {
        var tile = input.closest('.up');
        var fname = tile.querySelector('.fname');
        var pill = tile.querySelector('.pill');
        if (input.files && input.files.length) {
          tile.classList.add('filled');
          fname.textContent = '✓ ' + input.files[0].name;
          if (pill) pill.textContent = '변경';
        } else {
          tile.classList.remove('filled');
          fname.textContent = '';
          if (pill) pill.textContent = '파일 선택';
        }
        refreshCount();
      });
    });
  </script>
</body>
</html>
