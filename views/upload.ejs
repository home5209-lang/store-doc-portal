<!DOCTYPE html>
<html lang="ko">
<head>
<%- include('partials/head', { title: '발신번호 등록 서류 제출' }) %>
</head>
<body>
  <div class="wrap">
    <div class="brand">
      <span class="dot">C</span>
      <span class="name">발신 번호 등록 관리자</span>
      <span class="sub">발신번호 등록</span>
    </div>

    <div class="card">
      <p class="eyebrow">서류 제출</p>
      <h1 class="title"><%= store.name === '매장명 미입력' ? '매장 정보를 입력해주세요' : store.name %></h1>
      <p class="lead">아래 정보를 채우고, 파일 2개(통신서비스 이용증명원·사업자등록증)를 올려주세요. 사용 승낙서와 재직 증명서는 <b>화면의 양식을 보고 (인) 자리에 직접 서명</b>하면 됩니다.</p>

      <div class="steps" aria-hidden="true" style="margin-top:16px;">
        <span class="bar on"></span><span class="bar on"></span><span class="bar"></span>
      </div>
      <div class="steplabels">
        <span class="done">✓ 매장 정보</span>
        <span class="cur">서류 제출</span>
        <span>제출 완료</span>
      </div>

      <% if (error) { %>
        <div class="alert alert-error" style="margin-top:16px;"><%= error %></div>
      <% } %>

      <form method="POST" enctype="multipart/form-data" id="mainForm">
        <div class="field">
          <label>매장명 <span class="req">*</span></label>
          <input class="input" type="text" name="name" value="<%= store.name === '매장명 미입력' ? '' : store.name %>" required />
          <div class="hint">캐치테이블 어드민에 등록된 매장명과 동일하게 입력해주세요.</div>
        </div>

        <div class="field">
          <label>대표자명 <span class="req">*</span></label>
          <input class="input" type="text" name="owner_name" value="<%= store.owner_name || '' %>" required />
        </div>

        <div class="field">
          <label>사업자등록번호 <span class="req">*</span></label>
          <input class="input" type="text" name="biz_reg_no" value="<%= store.biz_reg_no || '' %>" placeholder="000-00-00000" required />
        </div>

        <div class="field">
          <label>등록할 발신번호(전화번호) <span class="req">*</span></label>
          <input class="input" type="text" name="phone_numbers" value="<%= store.phone_numbers || '' %>" placeholder="예: 02-1234-5678 (여러 개면 쉼표로 구분)" required />
          <div class="hint">사용 승낙서의 전화번호 목록에 그대로 기재됩니다.</div>
        </div>

        <div class="field">
          <label>대표자 직위 <span class="req">*</span></label>
          <input class="input" type="text" name="contact_title" value="<%= store.contact_title || '' %>" placeholder="예: 대표" required />
          <div class="hint">재직증명서에 대표자 직위로 기재됩니다. (모든 서류의 인적사항은 사업자등록증과 동일해야 합니다.)</div>
        </div>

        <hr class="divider" />

        <div class="count-callout">
          <span class="l">제출 항목</span>
          <span class="n"><span id="upcount">0</span> / 4 완료</span>
        </div>

        <p class="section-label">첨부 파일 (2개)</p>

        <label class="up">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </span>
          <span class="meta">
            <span class="t">통신서비스 이용증명원 <span class="req">*</span></span>
            <span class="d">통신사 발급 파일 · 최근 3개월 이내</span>
            <span class="d warn-open">마스킹(가림) 없이 발급자 정보·번호가 모두 보여야 합니다</span>
            <span class="fname"></span>
          </span>
          <span class="pill">파일 선택</span>
          <input type="file" name="telecom_proof" required />
        </label>

        <label class="up">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
          <span class="meta">
            <span class="t">사업자 등록증 <span class="req">*</span></span>
            <span class="d">3개월 이내 발급본</span>
            <span class="d warn-mask">주민등록번호는 꼭 가려서(마스킹) 올려주세요</span>
            <span class="fname"></span>
          </span>
          <span class="pill">파일 선택</span>
          <input type="file" name="biz_reg" required />
        </label>

        <p class="section-label" style="margin-top:20px;">양식 보고 서명 (2개)</p>

        <div class="up sign-card" id="card-consent">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </span>
          <span class="meta">
            <span class="t">사용 승낙서 <span class="req">*</span></span>
            <span class="d">양식을 보고 (인) 자리에 서명하면 자동 첨부됩니다</span>
            <span class="fname" id="done-consent"></span>
            <a class="preview-link" id="prev-consent" href="/upload/<%= store.id %>/<%= token %>/preview/consent" target="_blank" style="display:none;">📄 작성한 서류 미리보기</a>
          </span>
          <button type="button" class="pill" data-sign="consent">양식 보고 서명</button>
        </div>

        <div class="up sign-card" id="card-employment">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </span>
          <span class="meta">
            <span class="t">재직 증명서 <span class="req">*</span></span>
            <span class="d">생년월일·재직기간 입력 후 (인) 자리에 서명하면 자동 첨부됩니다</span>
            <span class="fname" id="done-employment"></span>
            <a class="preview-link" id="prev-employment" href="/upload/<%= store.id %>/<%= token %>/preview/employment" target="_blank" style="display:none;">📄 작성한 서류 미리보기</a>
          </span>
          <button type="button" class="pill" data-sign="employment">양식 보고 서명</button>
        </div>

        <div class="autobox">
          <p class="cap">캐치테이블 이용계약서는 담당자가 확인·첨부합니다 — 매장에서 올리실 필요 없어요.</p>
        </div>

        <div class="checklist">
          <p class="section-label" style="margin-bottom:6px;">제출 전 확인 <span class="req">*</span></p>
          <p class="checklist-sub">아래는 심사에서 자주 반려되는 항목이에요. 확인 후 체크해주세요.</p>
          <label class="chk"><input type="checkbox" class="pre-chk"><span>통신서비스 이용증명원·사업자등록증은 <b>최근 3개월 이내</b> 발급본입니다.</span></label>
          <label class="chk"><input type="checkbox" class="pre-chk"><span>통신서비스 이용증명원은 발급자 정보·전화번호가 <b>가려지지 않고 모두 보이게</b> 제출했습니다.</span></label>
          <label class="chk"><input type="checkbox" class="pre-chk"><span>사업자등록증은 <b>주민등록번호 뒷자리만</b> 가리고, 나머지는 가리지 않았습니다.</span></label>
          <label class="chk"><input type="checkbox" class="pre-chk"><span>입력한 대표자명·사업자등록번호가 <b>사업자등록증과 동일</b>합니다.</span></label>
        </div>

        <button class="btn btn-primary btn-block" type="submit" style="margin-top:18px;">제출하기</button>
      </form>
    </div>
  </div>

  <!-- 양식 보고 서명 모달 -->
  <div id="signOverlay" class="sign-overlay" aria-hidden="true">
    <div class="sign-box">
      <div class="sign-head">
        <span class="t" id="signTitle">양식 보고 서명</span>
        <button type="button" id="signClose" class="ex-close">✕ 닫기</button>
      </div>
      <p class="sign-guide">아래 양식의 <b>(인) 자리 서명란</b>에 손가락/마우스로 서명해주세요.</p>
      <div id="signDoc"></div>
      <div class="sign-foot">
        <button type="button" id="signClear" class="ex-close">서명 지우기</button>
        <button type="button" id="signCancel" class="ex-close">취소</button>
        <button type="button" id="signSubmit" class="btn btn-primary">확인하고 첨부</button>
      </div>
    </div>
  </div>

  <style>
    .warn-mask{color:#c0392b !important;font-weight:700;}
    .checklist{margin-top:20px;border:1px solid var(--border);border-radius:12px;padding:14px 16px;background:#FCFBFA;}
    .checklist-sub{font-size:12px;color:var(--muted);margin:0 0 10px;}
    .chk{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:#3A3A3A;line-height:1.5;padding:7px 0;cursor:pointer;}
    .chk input{margin-top:2px;width:17px;height:17px;flex:0 0 auto;accent-color:var(--brand);cursor:pointer;}
    .chk b{color:#1F1D1B;}
    .warn-open{color:#1C6B45 !important;font-weight:700;}
    .sign-card .pill{border:none;cursor:pointer;font:inherit;}
    .preview-link{margin-top:4px;font-size:12.5px;color:#FB6220;font-weight:600;text-decoration:none;}
    .preview-link:hover{text-decoration:underline;}
    .ex-close{padding:8px 14px;border:1px solid #ddd;border-radius:8px;background:#fff;cursor:pointer;font-size:13px;}
    .sign-overlay{position:fixed;inset:0;background:rgba(0,0,0,.62);display:none;
      align-items:flex-start;justify-content:center;z-index:1000;overflow:auto;padding:20px;}
    .sign-overlay.open{display:flex;}
    .sign-box{background:#fff;border-radius:14px;padding:18px;max-width:700px;width:100%;
      box-shadow:0 20px 60px rgba(0,0,0,.35);}
    .sign-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
    .sign-head .t{font-weight:700;font-size:16px;color:#222;}
    .sign-guide{font-size:13px;color:#c0392b;margin:0 0 12px;font-weight:600;}
    .sign-foot{display:flex;gap:10px;justify-content:flex-end;margin-top:16px;flex-wrap:wrap;}

    /* 문서 양식(미리보기) */
    .doc-paper{background:#fff;border:1px solid #ddd;border-radius:6px;padding:22px;color:#1c1c1c;
      font-size:13px;line-height:1.75;}
    .doc-paper.consent{border:2px solid #333;}
    .doc-title{font-weight:700;font-size:16px;margin-bottom:8px;}
    .doc-paper ul{list-style:disc;padding-left:20px;margin:8px 0;}
    .doc-paper ol{list-style:decimal;padding-left:22px;margin:4px 0;}
    .doc-title-c{text-align:center;font-weight:800;font-size:22px;letter-spacing:6px;margin-bottom:4px;}
    .doc-rule{height:2px;background:#B0824A;margin:6px 0 14px;}
    .doc-table{width:100%;border-collapse:collapse;margin:8px 0 14px;}
    .doc-table th,.doc-table td{border:1px solid #333;padding:8px 10px;font-size:13px;vertical-align:middle;}
    .doc-table th{background:#F3EFE7;width:34%;text-align:center;font-weight:700;}
    .doc-inline{border:none;border-bottom:1px solid #FB6220;font-size:13px;padding:3px 4px;min-width:150px;background:#fff7f2;}
    .center{text-align:center;}
    .right{text-align:right;}
    .sign-line{margin-top:16px;display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap;}
    .sign-line.left{justify-content:flex-start;}
    .sign-slot{position:relative;display:inline-block;border:1.5px dashed #FB6220;border-radius:6px;background:#fffdfb;}
    .sign-slot canvas{display:block;width:190px;height:56px;touch-action:none;}
    .sign-slot .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#e0a077;font-size:12px;pointer-events:none;}

    /* 실제 양식 이미지 위에서 서명 */
    .tpl-wrap{position:relative;width:100%;max-width:600px;margin:0 auto;}
    .tpl-img{width:100%;display:block;border:1px solid #e6e2dc;border-radius:4px;}
    .tpl-wrap .ov{position:absolute;transform:translateY(-50%);white-space:nowrap;color:#111;line-height:1;font-family:inherit;}
    .tpl-sign{position:absolute;transform:translateY(-50%);border:1.5px dashed #FB6220;border-radius:6px;background:rgba(251,98,32,.05);}
    .tpl-sign canvas{display:block;width:100%;height:auto;aspect-ratio:380/112;touch-action:none;}
    .tpl-sign .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#e0a077;font-size:12px;pointer-events:none;}

    /* 재직증명서 — 증명서 형태 */
    .cert{background:#fff;border:2px solid #2B2B2B;padding:30px 34px 40px;position:relative;}
    .cert::after{content:"";position:absolute;inset:6px;border:1px solid #9A9A9A;pointer-events:none;}
    .cert-title{text-align:center;font-size:26px;font-weight:800;letter-spacing:8px;color:#1B1B1B;margin:6px 0 0;}
    .cert-rule{width:180px;height:1.6px;background:#B0824A;margin:12px auto 26px;}
    .cert-rows{max-width:440px;margin:0 auto;}
    .cert-row{display:flex;align-items:flex-end;gap:8px;margin-bottom:16px;}
    .cert-row .cl{flex:0 0 118px;font-weight:700;color:#3A3A3A;font-size:13px;}
    .cert-row .cc{flex:0 0 8px;color:#3A3A3A;}
    .cert-row .cv{flex:1;min-width:0;border-bottom:1px solid #CFC7BB;padding:2px 2px 4px;font-size:13px;color:#111;}
    .cert-input{border:none;outline:none;width:100%;font:inherit;font-size:13px;color:#111;background:#fff7f2;padding:1px 3px;}
    .cert-stmt{text-align:center;font-size:13px;color:#111;margin:28px 0 10px;}
    .cert-use{text-align:center;font-size:12.5px;font-weight:700;color:#111;margin:0 0 22px;}
    .cert-date{text-align:center;margin:0 0 30px;}
    .cert-date .cert-input{max-width:220px;background:#fff7f2;}
    .cert-sign{text-align:right;}
    .cert-sign-name{font-size:13px;color:#111;margin-bottom:8px;}
    .cert-sign-line{font-size:13px;color:#111;display:flex;align-items:center;justify-content:flex-end;gap:6px;flex-wrap:wrap;}
    .cert-rep{white-space:nowrap;}
    .cert-in{white-space:nowrap;}
    .cert-sig{position:relative;display:inline-block;border:1.5px dashed #FB6220;border-radius:6px;background:rgba(251,98,32,.05);width:140px;flex:0 0 auto;}
    .cert-sig canvas{display:block;width:100%;height:auto;aspect-ratio:380/112;touch-action:none;}
    .cert-sig .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#e0a077;font-size:11px;pointer-events:none;}
  </style>

  <script>
    function v(name){ var el=document.querySelector('[name="'+name+'"]'); return el?el.value.trim():''; }
    function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function todayKo(){ var d=new Date(); return d.getFullYear()+' 년 '+(d.getMonth()+1)+' 월 '+d.getDate()+' 일'; }
    var signed = { consent:false, employment:false };
    var STORE_ID='<%= store.id %>', TOKEN='<%= token %>';

    // 카운터
    var fileInputs = document.querySelectorAll('.up input[type=file]');
    function refreshCount(){
      var n=0; fileInputs.forEach(function(i){ if(i.files&&i.files.length) n+=1; });
      if(signed.consent) n+=1; if(signed.employment) n+=1;
      var el=document.getElementById('upcount'); if(el) el.textContent=n;
    }
    fileInputs.forEach(function(input){
      input.addEventListener('change', function(){
        var tile=input.closest('.up'), fname=tile.querySelector('.fname'), pill=tile.querySelector('.pill');
        if(input.files&&input.files.length){ tile.classList.add('filled'); fname.textContent='✓ '+input.files[0].name; if(pill)pill.textContent='변경'; }
        else { tile.classList.remove('filled'); fname.textContent=''; if(pill)pill.textContent='파일 선택'; }
        refreshCount();
      });
    });

    // 서명패드 (문서 안 캔버스에 바인딩)
    var padCanvas=null, padCtx=null, drawing=false, hasInk=false;
    function bindPad(){
      padCanvas=document.getElementById('signPad'); if(!padCanvas) return;
      padCtx=padCanvas.getContext('2d'); drawing=false; hasInk=false;
      function pos(e){ var r=padCanvas.getBoundingClientRect(); var cx=(e.touches?e.touches[0].clientX:e.clientX)-r.left; var cy=(e.touches?e.touches[0].clientY:e.clientY)-r.top; return {x:cx*(padCanvas.width/r.width), y:cy*(padCanvas.height/r.height)}; }
      function start(e){ drawing=true; var p=pos(e); padCtx.beginPath(); padCtx.moveTo(p.x,p.y); hideic(); e.preventDefault(); }
      function move(e){ if(!drawing)return; var p=pos(e); padCtx.lineTo(p.x,p.y); padCtx.strokeStyle='#14226e'; padCtx.lineWidth=2.4; padCtx.lineCap='round'; padCtx.stroke(); hasInk=true; e.preventDefault(); }
      function up(){ drawing=false; }
      function hideic(){ var ph=padCanvas.parentNode.querySelector('.ph'); if(ph) ph.style.display='none'; }
      padCanvas.addEventListener('mousedown',start); padCanvas.addEventListener('mousemove',move); window.addEventListener('mouseup',up);
      padCanvas.addEventListener('touchstart',start,{passive:false}); padCanvas.addEventListener('touchmove',move,{passive:false}); padCanvas.addEventListener('touchend',up);
    }
    function clearPad(){ if(padCtx){ padCtx.clearRect(0,0,padCanvas.width,padCanvas.height); hasInk=false; var ph=padCanvas.parentNode.querySelector('.ph'); if(ph) ph.style.display='flex'; } }

    // 양식 이미지 위 오버레이(명의자·전화번호) 글자 크기를 이미지 폭에 맞춰 조정
    function sizeOverlays(){ var w=document.getElementById('tplWrap'); if(!w) return; var px=Math.max(10, w.clientWidth*0.0231); w.querySelectorAll('.ov').forEach(function(e){ e.style.fontSize=px+'px'; }); }
    window.addEventListener('resize', sizeOverlays);

    // 서명란 HTML (문서 안 (인) 자리)
    function signSlot(){ return '<span class="sign-slot"><canvas id="signPad" width="380" height="112"></canvas><span class="ph">여기에 서명</span></span>'; }

    // 사용 승낙서: 실제 양식 이미지 위에 값 얹고 (인) 자리에 서명
    function consentDoc(){
      return '<div class="tpl-wrap" id="tplWrap">'
        + '<img class="tpl-img" src="/assets/consent_bg_view.png" alt="전화번호 이용 승낙서" onload="sizeOverlays()">'
        + '<span class="ov" style="left:29%;top:30%;">'+esc(v('owner_name'))+'</span>'
        + '<span class="ov" style="left:22%;top:46.5%;">'+esc(v('phone_numbers'))+'</span>'
        + '<span class="ov" style="left:20.1%;top:91.8%;">'+esc(v('owner_name'))+'</span>'
        + '<span class="tpl-sign" style="left:27%;top:91.9%;width:40%;">'
        +   '<canvas id="signPad" width="380" height="112"></canvas><span class="ph">여기에 서명</span>'
        + '</span>'
        + '</div>';
    }
    // 재직 증명서: 증명서 형태(격자 없음) — 생년월일·재직기간·발급일은 문서 안에서 입력, (인) 자리에 서명
    function row(label, valueHtml){
      return '<div class="cert-row"><span class="cl">'+label+'</span><span class="cc">:</span><span class="cv">'+valueHtml+'</span></div>';
    }
    function employmentDoc(){
      return '<div class="cert">'
        + '<div class="cert-title">재 직 증 명 서</div><div class="cert-rule"></div>'
        + '<div class="cert-rows">'
        +   row('성 명', esc(v('owner_name')))
        +   row('생년월일', '<input class="cert-input" id="f-birth" placeholder="예: 1985. 03. 12">')
        +   row('직 위', esc(v('contact_title')))
        +   row('재직 기간', '<input class="cert-input" id="f-period" placeholder="예: 2020.01.01 ~ 현재">')
        +   row('소속(상호명)', esc(v('name')))
        +   row('사업자등록번호', esc(v('biz_reg_no')))
        + '</div>'
        + '<p class="cert-stmt">위 사람은 위와 같이 본 사업장에 재직하고 있음을 증명합니다.</p>'
        + '<p class="cert-use">용도 : NHN Cloud 발신번호 등록 심사 제출용</p>'
        + '<p class="cert-date"><input class="cert-input" id="f-issue" value="'+esc(todayKo())+'" style="text-align:center;"></p>'
        + '<div class="cert-sign">'
        +   '<div class="cert-sign-name">상호명 : '+esc(v('name'))+'</div>'
        +   '<div class="cert-sign-line"><span class="cert-rep">대표자 : '+esc(v('owner_name'))+'</span>'
        +     '<span class="cert-sig"><canvas id="signPad" width="380" height="112"></canvas><span class="ph">여기에 서명</span></span><span class="cert-in">(인)</span></div>'
        + '</div>'
        + '</div>';
    }

    var overlay=document.getElementById('signOverlay'), docBox=document.getElementById('signDoc'), titleEl=document.getElementById('signTitle');
    var currentKind=null;
    function openSign(kind){
      var need=['name','owner_name','biz_reg_no','phone_numbers','contact_title'];
      for(var i=0;i<need.length;i++){ if(!v(need[i])){ alert('먼저 위의 매장 정보(매장명·대표자명·사업자등록번호·발신번호·직위)를 모두 입력해주세요.'); return; } }
      currentKind=kind;
      titleEl.textContent = kind==='consent' ? '사용 승낙서 서명' : '재직 증명서 작성·서명';
      docBox.innerHTML = kind==='consent' ? consentDoc() : employmentDoc();
      bindPad();
      overlay.classList.add('open');
    }
    function closeSign(){ overlay.classList.remove('open'); currentKind=null; }
    document.querySelectorAll('[data-sign]').forEach(function(b){ b.addEventListener('click',function(){ openSign(b.getAttribute('data-sign')); }); });
    document.getElementById('signClose').addEventListener('click',closeSign);
    document.getElementById('signCancel').addEventListener('click',closeSign);
    document.getElementById('signClear').addEventListener('click',clearPad);
    overlay.addEventListener('click',function(e){ if(e.target===overlay) closeSign(); });

    document.getElementById('signSubmit').addEventListener('click', function(){
      if(!hasInk){ alert('(인) 자리에 서명을 해주세요.'); return; }
      var payload = { name:v('name'), owner_name:v('owner_name'), biz_reg_no:v('biz_reg_no'),
        phone_numbers:v('phone_numbers'), contact_title:v('contact_title'), signature: padCanvas.toDataURL('image/png') };
      if(currentKind==='employment'){
        var birth=(document.getElementById('f-birth')||{}).value||''; birth=birth.trim();
        var period=(document.getElementById('f-period')||{}).value||''; period=period.trim();
        var issue=(document.getElementById('f-issue')||{}).value||''; issue=issue.trim();
        if(!birth||!period||!issue){ alert('생년월일·재직기간·발급일을 입력해주세요.'); return; }
        payload.birth=birth; payload.period=period; payload.issueDate=issue;
      }
      var kind=currentKind, btn=this; btn.disabled=true; btn.textContent='저장 중…';
      fetch('/upload/'+STORE_ID+'/'+TOKEN+'/sign/'+kind, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) })
      .then(function(r){return r.json();}).then(function(res){
        btn.disabled=false; btn.textContent='확인하고 첨부';
        if(!res.ok){ alert('저장 실패: '+(res.error||'')); return; }
        signed[kind]=true;
        var card=document.getElementById('card-'+kind); card.classList.add('filled');
        document.getElementById('done-'+kind).textContent='✓ 작성·서명 완료';
        card.querySelector('[data-sign]').textContent='다시 작성';
        var pv=document.getElementById('prev-'+kind);
        if(pv){ pv.href='/upload/'+STORE_ID+'/'+TOKEN+'/preview/'+kind+'?t='+Date.now(); pv.style.display='inline-block'; }
        refreshCount(); closeSign();
      }).catch(function(e){ btn.disabled=false; btn.textContent='확인하고 첨부'; alert('저장 오류: '+e.message); });
    });

    document.getElementById('mainForm').addEventListener('submit', function(e){
      if(!signed.consent || !signed.employment){ e.preventDefault(); alert('사용 승낙서와 재직 증명서를 양식에서 서명해주세요.'); return; }
      var checks = document.querySelectorAll('.pre-chk');
      for(var i=0;i<checks.length;i++){ if(!checks[i].checked){ e.preventDefault(); alert('제출 전 확인 항목을 모두 체크해주세요.'); checks[i].closest('.chk').scrollIntoView({block:'center'}); return; } }
    });
  </script>
</body>
</html>
