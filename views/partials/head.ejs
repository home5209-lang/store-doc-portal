<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %></title>
<style>
  :root{
    --brand:#FB6220; --brand-strong:#E24E12; --brand-soft:#FFF1E9;
    --bg:#FBF9F7; --surface:#ffffff; --text:#1F1D1B; --muted:#8B8681; --border:#ECE8E3;
    --success:#1C6B45; --success-bg:#E6F4EC; --warn:#8A6A1F; --warn-bg:#F5EFE0;
    --radius:14px; --shadow:0 1px 2px rgba(24,20,18,.04),0 6px 20px rgba(24,20,18,.05);
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic","Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased;}
  a{color:var(--brand-strong);text-decoration:none}
  a:hover{text-decoration:underline}
  .wrap{max-width:520px;margin:0 auto;padding:28px 18px 64px;}
  .wrap-wide{max-width:1080px;margin:0 auto;padding:24px 24px 64px;}

  /* brand header */
  .brand{display:flex;align-items:center;gap:10px;margin-bottom:22px;}
  .brand .dot{width:28px;height:28px;border-radius:9px;background:var(--brand);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;box-shadow:0 2px 8px rgba(251,98,32,.35);}
  .brand .name{font-weight:700;font-size:15px;letter-spacing:-.2px;}
  .brand .sub{color:var(--muted);font-size:12px;margin-left:auto;}

  /* card */
  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:26px 24px;}
  .card + .card{margin-top:16px;}
  .eyebrow{color:var(--brand-strong);font-size:12px;font-weight:700;letter-spacing:.4px;margin:0 0 8px;text-transform:uppercase;}
  h1.title{font-size:22px;font-weight:800;letter-spacing:-.4px;margin:0 0 6px;}
  .lead{color:var(--muted);font-size:13.5px;margin:0;}

  /* fields */
  .field{margin-top:16px;}
  .field label{display:block;font-size:13px;font-weight:600;color:#4A4844;margin-bottom:6px;}
  .req{color:var(--brand);}
  .input{width:100%;padding:11px 12px;border:1px solid #DFDBD5;border-radius:10px;font-size:14px;background:#fff;transition:border-color .15s,box-shadow .15s;font-family:inherit;}
  .input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-soft);}
  .hint{color:var(--muted);font-size:12px;margin-top:5px;}

  /* file dropzone (legacy, 남겨둠) */
  .drop{display:flex;align-items:center;gap:12px;justify-content:space-between;border:1.5px dashed #D8D3CC;border-radius:12px;padding:14px 16px;margin-top:10px;background:#FCFBFA;}
  .drop .t{font-size:14px;font-weight:600;}
  .drop .d{font-size:12px;color:var(--muted);margin-top:2px;}
  .drop input[type=file]{font-size:12px;max-width:52%;}

  /* upload tile (클릭 전체영역 + 파일명 표시) */
  .up{position:relative;display:flex;align-items:center;gap:14px;border:1.6px dashed #F0C4A8;border-radius:14px;background:#FFFCFA;padding:16px;margin-top:10px;cursor:pointer;transition:border-color .15s,background .15s,box-shadow .15s;}
  .up:hover{border-color:var(--brand);background:var(--brand-soft);box-shadow:0 4px 14px rgba(251,98,32,.10);}
  .up input[type=file]{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;}
  .up .ic{flex:0 0 auto;width:44px;height:44px;border-radius:12px;background:#fff;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--brand);}
  .up .ic svg{width:22px;height:22px;}
  .up .meta{flex:1;min-width:0;}
  .up .t{display:block;font-size:14px;font-weight:700;color:var(--text);}
  .up .d{display:block;font-size:12px;color:var(--muted);margin-top:2px;}
  .up .fname{display:none;font-size:12.5px;font-weight:600;color:var(--success);margin-top:5px;word-break:break-all;}
  .up .pill{flex:0 0 auto;font-size:12.5px;font-weight:600;color:var(--brand-strong);background:#fff;border:1px solid #F3CDB6;padding:8px 13px;border-radius:10px;white-space:nowrap;}
  .up.filled{border-style:solid;border-color:var(--success);background:var(--success-bg);}
  .up.filled .ic{color:var(--success);border-color:#CDE7D7;}
  .up.filled .d{display:none;}
  .up.filled .fname{display:block;}
  .up.filled .pill{color:var(--success);border-color:#CDE7D7;}

  /* auto rows */
  .auto{display:flex;align-items:center;gap:10px;justify-content:space-between;padding:12px 14px;background:#FAF7F4;border:1px solid var(--border);border-radius:11px;margin-top:8px;}
  .auto .left{display:flex;align-items:center;gap:10px;min-width:0;}
  .auto .aic{flex:0 0 auto;width:30px;height:30px;border-radius:8px;background:#fff;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--brand);}
  .auto .aic svg{width:16px;height:16px;}
  .auto .t{font-size:13.5px;color:#4A4844;font-weight:600;}

  /* badges */
  .badge{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px;white-space:nowrap;}
  .badge.green{background:var(--success-bg);color:var(--success);}
  .badge.warn{background:var(--warn-bg);color:var(--warn);}
  .badge.gray{background:#F0EDE8;color:#8B8681;}
  .badge.red{background:var(--brand-soft);color:#B3261E;}
  .reject-reason{display:block;font-size:11px;color:#B3261E;margin-top:4px;line-height:1.4;max-width:200px;}
  .checked-at{display:block;font-size:10.5px;color:var(--muted);margin-top:3px;}

  /* buttons */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:none;border-radius:11px;font-size:14px;font-weight:600;cursor:pointer;padding:12px 18px;transition:transform .05s,background .15s;font-family:inherit;}
  .btn:active{transform:translateY(1px);}
  .btn-primary{background:var(--brand);color:#fff;box-shadow:0 3px 10px rgba(251,98,32,.28);}
  .btn-primary:hover{background:var(--brand-strong);}
  .btn-block{width:100%;padding:14px;font-size:15px;}
  .btn-ghost{background:#fff;border:1px solid #DBD6CF;color:var(--text);}
  .btn-ghost:hover{background:#FAF7F4;}
  .btn-sm{padding:8px 13px;font-size:13px;border-radius:9px;}

  .divider{border:0;border-top:1px solid var(--border);margin:20px 0;}
  .section-label{font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.3px;text-transform:uppercase;margin:0 0 2px;}

  /* alerts / banners */
  .alert{padding:11px 14px;border-radius:10px;font-size:13px;margin-bottom:14px;}
  .alert-error{background:var(--brand-soft);color:#B3261E;}
  .banner{background:#EAF1FB;color:#1a56db;padding:12px 14px;border-radius:10px;font-size:12.5px;word-break:break-all;margin-bottom:16px;border:1px solid #d9e4f7;}

  /* table */
  .table-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;}
  table{width:100%;border-collapse:collapse;}
  th,td{padding:13px 16px;font-size:13px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top;}
  th{background:#FAF7F4;color:#6E6A64;font-weight:600;font-size:12px;letter-spacing:.2px;}
  tr:last-child td{border-bottom:none;}
  td .name-strong{font-weight:700;font-size:14px;}
  .status{display:inline-block;padding:4px 11px;border-radius:999px;font-size:12px;font-weight:600;}
  .status.submitted{background:var(--success-bg);color:var(--success);}
  .status.pending{background:var(--warn-bg);color:var(--warn);}
  .doclist{display:flex;flex-direction:column;gap:6px;}
  .doclist a{font-size:12.5px;}
  .doclist .missing{color:#B5B2AB;font-size:12.5px;}
  .link-strong{color:var(--brand-strong);font-weight:600;font-size:12.5px;}
  .empty{padding:48px 20px;text-align:center;color:var(--muted);}

  /* candidate cards */
  .cand{background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:15px 17px;margin-bottom:11px;display:flex;justify-content:space-between;align-items:center;gap:16px;}
  .cand .c-title{font-size:14.5px;font-weight:700;margin:0 0 5px;}
  .cand .c-meta{font-size:12px;color:var(--muted);line-height:1.5;}
  .score{display:inline-block;background:var(--warn-bg);color:var(--warn);border-radius:999px;padding:2px 9px;font-size:11px;font-weight:600;margin-left:7px;}

  /* center screens */
  .center{max-width:440px;margin:72px auto 0;text-align:center;}
  .icon-badge{width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:27px;}
  .icon-badge.green{background:var(--success-bg);color:var(--success);}
  .icon-badge.red{background:var(--brand-soft);color:var(--brand);}
  .center h1{font-size:19px;font-weight:800;margin:0 0 10px;letter-spacing:-.3px;}
  .center p{font-size:13.5px;color:var(--muted);line-height:1.65;margin:0;}

  .inline-form{display:flex;gap:8px;}
  .inline-form .input{flex:1;}

  /* ── 스텝퍼 (업로드 폼 상단) ── */
  .steps{display:flex;align-items:center;gap:6px;margin:2px 0 14px;}
  .steps .bar{flex:1;height:6px;border-radius:99px;background:var(--border);}
  .steps .bar.on{background:var(--success);}
  .steplabels{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:18px;}
  .steplabels .done{color:var(--success);}
  .steplabels .cur{color:var(--text);font-weight:700;}

  /* 준비 현황 카운트 콜아웃 */
  .count-callout{display:flex;align-items:center;justify-content:space-between;background:var(--brand-soft);border-radius:10px;padding:11px 14px;margin-bottom:16px;}
  .count-callout .l{font-size:13px;color:var(--brand-strong);}
  .count-callout .n{font-size:15px;font-weight:800;color:var(--brand-strong);}

  /* 자동 준비 서류 칩 콜아웃 */
  .autobox{border:1px solid var(--border);border-radius:12px;padding:13px 15px;margin-top:14px;background:#FCFBFA;}
  .autobox .cap{font-size:12px;color:var(--muted);margin:0 0 9px;font-weight:600;}
  .chips{display:flex;flex-wrap:wrap;gap:7px;}
  .chip{font-size:12px;color:#5F5E5A;background:#fff;border:1px solid var(--border);border-radius:999px;padding:5px 11px;display:inline-flex;align-items:center;gap:5px;}
  .chip .ok{color:var(--success);font-weight:800;}

  /* ── 관리자 대시보드 ── */
  .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0;}
  .metric{background:#fff;border:1px solid var(--border);border-radius:12px;padding:13px 14px;}
  .metric .k{font-size:12px;color:var(--muted);}
  .metric .v{font-size:24px;font-weight:800;letter-spacing:-.5px;margin-top:3px;}
  .metric .v.warn{color:var(--warn);} .metric .v.acc{color:#1a56db;} .metric .v.ok{color:var(--success);}

  .srow{display:flex;align-items:center;gap:16px;padding:15px 18px;border-bottom:1px solid var(--border);}
  .srow:last-child{border-bottom:none;}
  .srow .info{flex:1 1 30%;min-width:0;}
  .srow .info .nm{font-size:14.5px;font-weight:700;}
  .srow .info .sub{font-size:12px;color:var(--muted);margin-top:2px;}
  .dots{display:flex;gap:5px;align-items:center;flex:0 0 auto;}
  .dot{width:15px;height:15px;border-radius:50%;display:inline-flex;}
  .dot.on{background:var(--success);}
  .dot.off{background:#E6E2DC;border:1px solid #DAD5CE;}
  .docs-mini{flex:1 1 34%;min-width:0;display:flex;flex-direction:column;gap:5px;}
  .docrow{display:flex;align-items:center;gap:8px;font-size:12.5px;}
  .docrow .dname{color:#4A4844;}
  .docrow .missing{color:#B5B2AB;}
  .docrow .acts{margin-left:auto;display:flex;gap:6px;white-space:nowrap;align-items:center;}
  .docrow .acts a{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:600;color:#5F5E5A;border:1px solid var(--border);border-radius:8px;padding:3px 9px;text-decoration:none;transition:border-color .12s,background .12s,color .12s;}
  .docrow .acts a svg{width:13px;height:13px;}
  .docrow .acts a:hover{border-color:var(--brand);color:var(--brand-strong);background:var(--brand-soft);text-decoration:none;}
  .docrow .acts a.prev{color:var(--brand-strong);border-color:#F3CDB6;}
  .docrow .acts a.link-strong{color:var(--brand-strong);border-color:#F3CDB6;}
  .docrow .acts .missing{font-size:11.5px;color:#B5B2AB;}
  .actions-col{flex:0 0 auto;display:flex;flex-direction:column;gap:7px;align-items:flex-end;}

  /* NHN 심사 상태 — 또렷한 큰 배지 */
  .nhn-stat{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:800;letter-spacing:-.2px;padding:7px 14px;border-radius:999px;border:1.5px solid transparent;white-space:nowrap;}
  .nhn-stat .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;}
  .nhn-stat.review{background:var(--warn-bg);color:#7A5A12;border-color:#E7D6A6;}
  .nhn-stat.review .dot{background:var(--warn);animation:nhnpulse 1.1s ease-in-out infinite;}
  .nhn-stat.done{background:var(--success-bg);color:#12543A;border-color:#BFE3CF;}
  .nhn-stat.done .dot{background:var(--success);}
  .nhn-stat.rejected{background:var(--brand-soft);color:#A3231C;border-color:#F3C2BE;}
  .nhn-stat.rejected .dot{background:#D42A20;}
  @keyframes nhnpulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.8)}}

  /* 서류 보기 팝업(모달) */
  .modal-overlay{display:none;position:fixed;inset:0;background:rgba(24,20,18,.45);z-index:50;padding:40px 16px;overflow:auto;}
  .modal-overlay.open{display:flex;align-items:flex-start;justify-content:center;}
  .modal{background:var(--surface);border-radius:16px;max-width:580px;width:100%;box-shadow:0 20px 60px rgba(24,20,18,.28);overflow:hidden;}
  .modal .mhead{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:18px 20px;border-bottom:1px solid var(--border);}
  .modal .mhead .mt{font-size:16px;font-weight:800;letter-spacing:-.3px;}
  .modal .mhead .msub{font-size:12px;color:var(--muted);margin-top:3px;}
  .modal .mclose{flex:0 0 auto;width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:#fff;color:var(--muted);font-size:15px;cursor:pointer;line-height:1;}
  .modal .mclose:hover{background:#FAF7F4;color:var(--text);}
  .modal .mbody{padding:16px 20px;}
  .modal .mbody .docrow{padding:9px 0;border-bottom:1px solid var(--border);}
  .modal .mbody .docrow:last-child{border-bottom:none;}
  .modal.wide{max-width:640px;}

  /* 사용 가이드 — 오른쪽 사이드 드로어(뒷 화면 작업 가능, 배경 안 막음) */
  .guide-drawer{position:fixed;top:0;right:0;height:100vh;width:min(400px,92vw);background:var(--surface);
    box-shadow:-10px 0 40px rgba(24,20,18,.18);border-left:1px solid var(--border);
    transform:translateX(100%);transition:transform .25s ease;z-index:60;display:flex;flex-direction:column;}
  .guide-drawer.open{transform:translateX(0);}
  .gd-head{position:sticky;top:0;background:var(--surface);display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid var(--border);}
  .gd-head .mt{font-size:16px;font-weight:800;letter-spacing:-.3px;}
  .gd-head .msub{font-size:12px;color:var(--muted);margin-top:3px;}
  .gd-body{padding:14px 18px 32px;overflow-y:auto;}
  .guide-fab{position:fixed;right:18px;bottom:18px;z-index:40;box-shadow:0 4px 16px rgba(251,98,32,.35);border-radius:999px;}

  /* 사용자 바 / 담당자 / 활동 로그 */
  .userbar{display:flex;align-items:center;gap:10px;margin-left:auto;font-size:12.5px;color:var(--muted);}
  .userbar .who{color:#4A4844;font-weight:600;}
  .actor{font-size:11.5px;color:var(--muted);margin-top:5px;}
  .actor b{color:#6E6A64;font-weight:600;}
  .alog{width:100%;border-collapse:collapse;}
  .alog th,.alog td{padding:11px 14px;font-size:12.5px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top;}
  .alog th{background:#FAF7F4;color:#6E6A64;font-weight:600;font-size:12px;}
  .alog tr:last-child td{border-bottom:none;}
  .alog .u{font-weight:600;color:#4A4844;}
  .alog .t{color:var(--muted);white-space:nowrap;}
  .act-pill{display:inline-block;background:var(--brand-soft);color:var(--brand-strong);border-radius:999px;padding:2px 9px;font-size:11.5px;font-weight:600;}

  .gintro{font-size:13px;color:#5F5E5A;margin:0 0 6px;line-height:1.6;}
  .gstep{display:flex;gap:14px;padding:18px 0;border-bottom:1px solid var(--border);}
  .gstep:last-child{border-bottom:none;}
  .gnum{flex:0 0 auto;width:28px;height:28px;border-radius:50%;background:var(--brand);color:#fff;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 7px rgba(251,98,32,.3);}
  .gbody{flex:1;min-width:0;}
  .gbody h4{margin:3px 0 5px;font-size:15px;font-weight:800;letter-spacing:-.2px;}
  .gbody p{margin:0;font-size:13px;color:#5F5E5A;line-height:1.65;}
  .gillust{margin-top:11px;border:1px solid var(--border);border-radius:10px;background:#FCFBFA;padding:12px;}
  .gillust svg{display:block;width:100%;height:auto;}

  @media(max-width:660px){
    th:nth-child(2),td:nth-child(2){display:none;}
    .wrap-wide{padding:18px 13px 50px;}
    .cand{flex-direction:column;align-items:stretch;}
    .metrics{grid-template-columns:repeat(2,1fr);}
    .srow{flex-wrap:wrap;gap:10px;}
    .srow .info{flex:1 1 100%;}
    .docs-mini{flex:1 1 100%;}
    .actions-col{flex-direction:row;flex-wrap:wrap;align-items:flex-start;}
  }
</style>
