<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %></title>
<style>
  :root{
    --brand:#F0323C; --brand-strong:#D31F2B; --brand-soft:#FDECEC;
    --bg:#FBF9F7; --surface:#ffffff; --text:#1F1D1B; --muted:#8B8681; --border:#ECE8E3;
    --success:#1C6B45; --success-bg:#E6F4EC; --warn:#8A6A1F; --warn-bg:#F5EFE0;
    --radius:14px; --shadow:0 1px 2px rgba(24,20,18,.04),0 6px 20px rgba(24,20,18,.05);
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic","Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased;}
  a{color:var(--brand-strong);text-decoration:none}
  a:hover{text-decoration:underline}
  .wrap{max-width:520px;margin:0 auto;padding:28px 18px 64px;}
  .wrap-wide{max-width:1080px;margin:0 auto;padding:24px 24px 64px;}

  /* brand header */
  .brand{display:flex;align-items:center;gap:10px;margin-bottom:22px;}
  .brand .dot{width:28px;height:28px;border-radius:9px;background:var(--brand);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;box-shadow:0 2px 8px rgba(240,50,60,.35);}
  .brand .name{font-weight:700;font-size:15px;letter-spacing:-.2px;}
  .brand .sub{color:var(--muted);font-size:12px;margin-left:auto;}

  /* card */
  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:26px 24px;}
  .card + .card{margin-top:16px;}
  .eyebrow{color:var(--brand-strong);font-size:12px;font-weight:700;letter-spacing:.4px;margin:0 0 8px;text-transform:uppercase;}
  h1.title{font-size:22px;font-weight:800;letter-spacing:-.4px;margin:0 0 6px;}
  .lead{color:var(--muted);font-size:13.5px;margin:0;}

  /* fields */
  .field{margin-top:16px;}
  .field label{display:block;font-size:13px;font-weight:600;color:#4A4844;margin-bottom:6px;}
  .req{color:var(--brand);}
  .input{width:100%;padding:11px 12px;border:1px solid #DFDBD5;border-radius:10px;font-size:14px;background:#fff;transition:border-color .15s,box-shadow .15s;font-family:inherit;}
  .input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-soft);}
  .hint{color:var(--muted);font-size:12px;margin-top:5px;}

  /* file dropzone */
  .drop{display:flex;align-items:center;gap:12px;justify-content:space-between;border:1.5px dashed #D8D3CC;border-radius:12px;padding:14px 16px;margin-top:10px;background:#FCFBFA;}
  .drop .t{font-size:14px;font-weight:600;}
  .drop .d{font-size:12px;color:var(--muted);margin-top:2px;}
  .drop input[type=file]{font-size:12px;max-width:52%;}

  /* auto rows */
  .auto{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;background:#FAF7F4;border:1px solid var(--border);border-radius:10px;margin-top:8px;}
  .auto .t{font-size:13.5px;color:#4A4844;}

  /* badges */
  .badge{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px;white-space:nowrap;}
  .badge.green{background:var(--success-bg);color:var(--success);}
  .badge.warn{background:var(--warn-bg);color:var(--warn);}
  .badge.gray{background:#F0EDE8;color:#8B8681;}

  /* buttons */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:none;border-radius:11px;font-size:14px;font-weight:600;cursor:pointer;padding:12px 18px;transition:transform .05s,background .15s;font-family:inherit;}
  .btn:active{transform:translateY(1px);}
  .btn-primary{background:var(--brand);color:#fff;box-shadow:0 3px 10px rgba(240,50,60,.28);}
  .btn-primary:hover{background:var(--brand-strong);}
  .btn-block{width:100%;padding:14px;font-size:15px;}
  .btn-ghost{background:#fff;border:1px solid #DBD6CF;color:var(--text);}
  .btn-ghost:hover{background:#FAF7F4;}
  .btn-sm{padding:8px 13px;font-size:13px;border-radius:9px;}

  .divider{border:0;border-top:1px solid var(--border);margin:20px 0;}
  .section-label{font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.3px;text-transform:uppercase;margin:0 0 2px;}

  /* alerts / banners */
  .alert{padding:11px 14px;border-radius:10px;font-size:13px;margin-bottom:14px;}
  .alert-error{background:var(--brand-soft);color:#B3261E;}
  .banner{background:#EAF1FB;color:#1a56db;padding:12px 14px;border-radius:10px;font-size:12.5px;word-break:break-all;margin-bottom:16px;border:1px solid #d9e4f7;}

  /* table */
  .table-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;}
  table{width:100%;border-collapse:collapse;}
  th,td{padding:13px 16px;font-size:13px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top;}
  th{background:#FAF7F4;color:#6E6A64;font-weight:600;font-size:12px;letter-spacing:.2px;}
  tr:last-child td{border-bottom:none;}
  td .name-strong{font-weight:700;font-size:14px;}
  .status{display:inline-block;padding:4px 11px;border-radius:999px;font-size:12px;font-weight:600;}
  .status.submitted{background:var(--success-bg);color:var(--success);}
  .status.pending{background:var(--warn-bg);color:var(--warn);}
  .doclist{display:flex;flex-direction:column;gap:6px;}
  .doclist a{font-size:12.5px;}
  .doclist .missing{color:#B5B2AB;font-size:12.5px;}
  .link-strong{color:var(--brand-strong);font-weight:600;font-size:12.5px;}
  .empty{padding:48px 20px;text-align:center;color:var(--muted);}

  /* candidate cards */
  .cand{background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:15px 17px;margin-bottom:11px;display:flex;justify-content:space-between;align-items:center;gap:16px;}
  .cand .c-title{font-size:14.5px;font-weight:700;margin:0 0 5px;}
  .cand .c-meta{font-size:12px;color:var(--muted);line-height:1.5;}
  .score{display:inline-block;background:var(--warn-bg);color:var(--warn);border-radius:999px;padding:2px 9px;font-size:11px;font-weight:600;margin-left:7px;}

  /* center screens */
  .center{max-width:440px;margin:72px auto 0;text-align:center;}
  .icon-badge{width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:27px;}
  .icon-badge.green{background:var(--success-bg);color:var(--success);}
  .icon-badge.red{background:var(--brand-soft);color:var(--brand);}
  .center h1{font-size:19px;font-weight:800;margin:0 0 10px;letter-spacing:-.3px;}
  .center p{font-size:13.5px;color:var(--muted);line-height:1.65;margin:0;}

  .inline-form{display:flex;gap:8px;}
  .inline-form .input{flex:1;}

  @media(max-width:660px){
    th:nth-child(2),td:nth-child(2){display:none;}
    .wrap-wide{padding:18px 13px 50px;}
    .cand{flex-direction:column;align-items:stretch;}
  }
</style>
